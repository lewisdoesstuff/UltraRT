{
  "version": 1,
  "note": "Light classes for every level (docs/lighting-overrides.md, 'Classes and rules'). The first matching rule gives a light its class. 'classes' holds what RT does with a class everywhere; a level's own file can add rules and class policies for that level.",
  "emitters": [
    {
      "name": "start and final room wall strips",
      "material": "^FinalFrame",
      "scale": 4.5,
      "note": "The glowing strips of the start room (and the final room, the same walls) carry the room instead of its floating orange lights. Measured at 4 and 5 (2026-11-17); 4.5 is between them. Shipped 2026-11-17 (user: the sheets 'look great')."
    }
  ],
  "classes": {
    "prefab:firstroom": {
      "intensity": 0,
      "note": "Replaced by the wall strips (emitters)."
    },
    "prefab:finalroom": {
      "intensity": 0,
      "note": "As the start room: the same walls. Not verified at a pose yet."
    },
    "fill": {
      "reach": 0,
      "note": "Punch (docs/lighting-overrides.md): no further than in the game, full strength."
    },
    "scripted": {
      "reach": 0,
      "note": "Punch (docs/lighting-overrides.md): no further than in the game, full strength."
    },
    "fixture": {
      "reach": 0,
      "intensity": 2.5,
      "medium": 0.4,
      "note": "Punch: no further than in the game, x2.5 (2026-11-18, was x1.8), haze as before (medium 1/2.5)."
    },
    "accent": {
      "reach": 0,
      "intensity": 2.5,
      "medium": 0.4,
      "note": "Punch: no further than in the game, x2.5 (2026-11-18, was x1.8), haze as before (medium 1/2.5)."
    },
    "glow": {
      "reach": 0,
      "intensity": 2.5,
      "medium": 0.4,
      "note": "Punch: no further than in the game, x2.5 (2026-11-18, was x1.8), haze as before (medium 1/2.5)."
    },
    "effect": {
      "reach": 0,
      "intensity": 2.5,
      "medium": 0.4,
      "note": "Punch: no further than in the game, x2.5 (2026-11-18, was x1.8), haze as before (medium 1/2.5)."
    },
    "item": {
      "reach": 0,
      "intensity": 2.5,
      "medium": 0.4,
      "note": "Punch: no further than in the game, x2.5 (2026-11-18, was x1.8), haze as before (medium 1/2.5)."
    }
  },
  "rules": [
    {
      "name": "start room",
      "path": "(^|/)[^/]*FirstRoom[^/]*/Room/((Pit|Hallway)[^/]*/)?Point Light[^/]*$",
      "class": "prefab:firstroom"
    },
    {
      "name": "shop",
      "path": "Shop/(Canvas/)?Point Light[^/]*$",
      "class": "prefab:shop"
    },
    {
      "name": "final door",
      "path": "FinalDoor/OpenedLight[^/]*$",
      "class": "prefab:finaldoor"
    },
    {
      "name": "final room",
      "path": "(^|/)[^/]*FinalRoom[^/]*/((Pit|Hallway|Room|Layer)[^/]*/)*Point Light[^/]*$",
      "class": "prefab:finalroom"
    },
    {
      "name": "checkpoint",
      "path": "Checkpoint[^/]*/(Quad|EnabledEffects/Point Light)[^/]*$",
      "class": "prefab:checkpoint"
    },
    {
      "name": "large door",
      "path": "(Large ?Door|FerryDoor|GothicDoor)[^/]*/Point Light[^/]*$",
      "class": "prefab:door"
    },
    {
      "name": "level transition pit",
      "path": "(Level Transition Pit/|(^|/)Pit[^/]*/(Lights|Layer)[^/]*/Point Light)",
      "class": "prefab:pit"
    },
    {
      "name": "lightning",
      "path": "Lightning",
      "class": "lightning"
    },
    {
      "name": "gameplay object",
      "path": "(Altar|GrapplePoint|HookPoint|Landmine|Switch|OK Light|Door Light|Sequence Light|WarningSign|Lights \\((Blue|Red|Rainbow)\\)|Button|Alarm|Bonus|Pedestal)",
      "class": "gameplay"
    },
    {
      "name": "open fire fixture",
      "signals": [
        "lifted"
      ],
      "class": "fixture:torch"
    },
    {
      "name": "statue orb",
      "signals": [
        "orb"
      ],
      "class": "fixture:orb"
    },
    {
      "name": "statue orb by name",
      "path": "Sphere_\\d+/Point Light[^/]*$",
      "class": "fixture:orb"
    },
    {
      "name": "torch by name",
      "path": "(torch|brazier|candle|flame|campfire|bonfire|/Fire( \\(\\d+\\))?$)",
      "class": "fixture:torch"
    },
    {
      "name": "window by name",
      "path": "(window|skylight)[^/]*/[^/]*$",
      "class": "fixture:window"
    },
    {
      "name": "screen by name",
      "path": "(screen|monitor|terminal|hologram)[^/]*/[^/]*$",
      "class": "fixture:screen"
    },
    {
      "name": "lamp by name",
      "path": "(lamp|lantern|bulb|chandelier|sconce|fluor|neon|streetlight|light ?post|hotellight|officelight|tubelight|ventlight|lightpillar|tunnel light)[^/]*(/[^/]*){0,2}$",
      "class": "fixture:lamp"
    },
    {
      "name": "in a fixture",
      "signals": [
        "fixture"
      ],
      "class": "fixture:lamp"
    },
    {
      "name": "in a lamp shade",
      "signals": [
        "enclosed"
      ],
      "class": "fixture:lamp"
    },
    {
      "name": "scripted",
      "signals": [
        "scripted"
      ],
      "class": "scripted"
    },
    {
      "name": "animated",
      "signals": [
        "animated"
      ],
      "class": "scripted"
    },
    {
      "name": "floating spot",
      "type": "spot",
      "class": "accent"
    },
    {
      "name": "floating point, room-sized",
      "type": "point",
      "rangeMin": 12,
      "class": "fill"
    },
    {
      "name": "floating point, small",
      "type": "point",
      "class": "glow"
    }
  ]
}
