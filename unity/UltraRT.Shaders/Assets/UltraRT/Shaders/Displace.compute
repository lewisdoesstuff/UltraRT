// Vertex displacement for the RT scene (src/UltraRT/SceneProxies.Displaced.cs, docs/scene-proxies.md "Vertex displacement").
//
// ULTRAKILL's Master shader moves vertices in its vertex shader when VERTEX_DISPLACEMENT is on (3-2's flesh walls and
// heart, water waves, lava, acid). Our proxies trace a per-renderer copy of the mesh; this kernel writes the displaced
// pose into that copy's vertex buffer each frame, before the RTAS build (the proxy is DynamicGeometry, so the build
// rebuilds its BLAS from it). Before overwriting, it copies the old position into the shared previous-pose buffer, which
// the hit shader's HitMotion reads like a skinned proxy's previous pose: per-vertex motion vectors.
//
// The function is the game's, read from the compiled Master vertex shader (all VERTEX_DISPLACEMENT variants share it;
// VERTEX_WARPING and VERTEX_LIGHTING only change what comes after). World space, per vertex:
//   origin  = _LocalOffset != 0 ? object position : 0
//   rev     = _ReverseFlow == 1
//   mode 0: dir = normalize(max(_FlowDirection.xyz, 0)) * (rev ? 3 : -1)
//           s   = dot(p - origin, dir) * _VertexNoiseScale * 0.1 + _Time.x * _VertexNoiseSpeed
//           d   = (tex(_VertexNoiseTex, (s, s)).r - 0.5) * _VertexNoiseAmplitude * dir      (* colour.g if _VColStrength == 1)
//   mode 2: w = (colour.r * 2 - 1) * sin((rev ? -1 : 1) * _VertexNoiseSpeed * _Time.y) * 0.5 + 0.5   (* colour.g if _VColStrength == 1)
//   mode 1: w = |frac(frac(uv.y * scale * 0.1) * scale + (rev ? -1 : 1) * speed * _Time.y) * 2 - 1|
//   mode 3: w = (tex(_VertexNoiseTex, uv * _UVNoiseScale + _UVNoiseSpeed * _Time.y).r - 0.5) * amplitude * 0.1
//   other modes: w = 0;  modes 1-3: d = n * w * amplitude * 5
//   p' = p + d; with _PreventClipping == 1: p' = lerp(p', p, saturate((5 - |p' - camera|) / 3))
// _RecalculateNormals == 1: the same function at two neighbours p + T * k and p + B * k (k = _NormalOffsetScale; T is
// (-0.05 n.y / n.x, 0.05, 0) normalised, B = normalize(cross(n, T)); their uv is uv + T.xz * k * 0.1 and uv + B.xz * k * 0.1),
// normal = normalize(cross(normalize(p'T - p'), normalize(p'B - p'))). Where n.x is 0 the game's T is not finite; we keep
// the rest normal there instead of propagating NaN.

#pragma kernel Displace

struct RestVertex
{
    float3 pos;    // object space
    float3 nrm;    // object space
    float4 col;    // vertex colour (1 if the mesh has none)
    float2 uv;     // uv0
    uint   slot;   // index into _Params (5 float4 per material slot), or 0xffffffff: not displaced
};

StructuredBuffer<RestVertex> _Rest;
StructuredBuffer<float4>     _Params;
RWByteAddressBuffer          _Dst;       // the proxy mesh's vertex buffer (stream holding the position)
RWStructuredBuffer<float3>   _PrevPose;  // MotionVectors' shared previous-pose buffer (object space)

Texture2D<float4> _VertexNoiseTex;
SamplerState      sampler_VertexNoiseTex;

float4x4 _ObjectToWorld;   // affine; its inverse is computed here (one constant less per dispatch)
float4   _GameTime;        // the game's _Time (x = t / 20, y = t)
float4   _CameraPos;       // xyz: the main camera (the game's _WorldSpaceCameraPos)
int4     _Meta;            // x vertex count, y bytes per vertex in _Dst, z position offset, w normal offset (-1: not written)
int4     _Meta2;           // x first vertex in _PrevPose (-1: no previous pose)
uint     _Enabled;         // 0: write the rest pose

#define _Count     ((uint)_Meta.x)
#define _Stride    ((uint)_Meta.y)
#define _PosOffset ((uint)_Meta.z)
#define _NrmOffset (_Meta.w)
#define _PrevBase  (_Meta2.x)

// Inverse of an affine object-to-world matrix (3x3 by the adjugate, then the translation).
float4x4 InverseAffine(float4x4 m)
{
    float3 c0 = m._m00_m10_m20, c1 = m._m01_m11_m21, c2 = m._m02_m12_m22;
    float3 r0 = cross(c1, c2), r1 = cross(c2, c0), r2 = cross(c0, c1);
    float invDet = 1.0 / dot(c0, r0);
    float3x3 inv3 = float3x3(r0, r1, r2) * invDet;
    float3 t = -mul(inv3, m._m03_m13_m23);
    return float4x4(float4(inv3[0], t.x), float4(inv3[1], t.y), float4(inv3[2], t.z), float4(0, 0, 0, 1));
}

struct Mat
{
    float3 flow;
    float  mode, reverse, noiseScale, vcolStrength;
    float2 uvNoiseScale, uvNoiseSpeed;
    float  noiseSpeed, amplitude, localOffset, recalc, normalOffset, preventClip;
};

Mat LoadMat(uint slot)
{
    float4 a = _Params[slot * 5u], b = _Params[slot * 5u + 1u], c = _Params[slot * 5u + 2u], d = _Params[slot * 5u + 3u], e = _Params[slot * 5u + 4u];
    Mat m;
    m.flow = a.xyz;
    m.mode = b.x; m.reverse = b.y; m.noiseScale = b.z; m.vcolStrength = b.w;
    m.uvNoiseScale = c.xy; m.uvNoiseSpeed = c.zw;
    m.noiseSpeed = d.x; m.amplitude = d.y; m.localOffset = d.z; m.recalc = d.w;
    m.normalOffset = e.x; m.preventClip = e.y;
    return m;
}

// One displaced point: the game's function, world space.
float3 DisplacePoint(Mat m, float3 p, float3 n, float4 col, float2 uv, float3 origin)
{
    bool rev = m.reverse == 1.0;
    float sgn = rev ? -1.0 : 1.0;
    float3 d;
    if (m.mode == 0.0)
    {
        float3 dir = normalize(max(m.flow, 0.0)) * (rev ? 3.0 : -1.0);
        float s = dot(p - origin, dir) * m.noiseScale * 0.1 + _GameTime.x * m.noiseSpeed;
        float v = _VertexNoiseTex.SampleLevel(sampler_VertexNoiseTex, float2(s, s), 0).r;
        d = (v - 0.5) * m.amplitude * dir;
        if (m.vcolStrength == 1.0) d *= col.g;
    }
    else
    {
        float w;
        if (m.mode == 2.0)
        {
            w = (col.r * 2.0 - 1.0) * sin(sgn * m.noiseSpeed * _GameTime.y) * 0.5 + 0.5;
            if (m.vcolStrength == 1.0) w *= col.g;
        }
        else if (m.mode == 1.0)
        {
            float f = frac(frac(uv.y * m.noiseScale * 0.1) * m.noiseScale + sgn * m.noiseSpeed * _GameTime.y);
            w = abs(f * 2.0 - 1.0);
        }
        else if (m.mode == 3.0)
        {
            float v = _VertexNoiseTex.SampleLevel(sampler_VertexNoiseTex, uv * m.uvNoiseScale + m.uvNoiseSpeed * _GameTime.y, 0).r;
            w = (v - 0.5) * m.amplitude * 0.1;
        }
        else w = 0.0;
        d = n * w * m.amplitude * 5.0;
    }
    float3 q = p + d;
    if (m.preventClip == 1.0)
    {
        float k = saturate((length(q - _CameraPos.xyz) - 5.0) * -0.333333);
        q = lerp(q, p, k);
    }
    return q;
}

[numthreads(64, 1, 1)]
void Displace(uint id : SV_DispatchThreadID)
{
    if (id >= _Count) return;
    uint at = id * _Stride + _PosOffset;
    if (_PrevBase >= 0) _PrevPose[(uint)_PrevBase + id] = asfloat(_Dst.Load3(at));

    RestVertex r = _Rest[id];
    float3 pObj = r.pos, nObj = r.nrm;
    if (_Enabled != 0u && r.slot != 0xffffffffu)
    {
        Mat m = LoadMat(r.slot);
        float4x4 _WorldToObject = InverseAffine(_ObjectToWorld);
        float3 p = mul(_ObjectToWorld, float4(r.pos, 1.0)).xyz;
        float3 n = normalize(mul(r.nrm, (float3x3)_WorldToObject)); // UnityObjectToWorldNormal
        float3 origin = m.localOffset != 0.0 ? _ObjectToWorld._m03_m13_m23 : 0.0;
        float3 q = DisplacePoint(m, p, n, r.col, r.uv, origin);
        pObj = mul(_WorldToObject, float4(q, 1.0)).xyz;
        if (m.recalc == 1.0)
        {
            float k = m.normalOffset;
            float3 t = normalize(float3(-0.05 * n.y / n.x, 0.05, 0.0));
            float3 b = normalize(cross(n, t));
            float3 qt = DisplacePoint(m, p + t * k, n, r.col, r.uv + t.xz * k * 0.1, origin);
            float3 qb = DisplacePoint(m, p + b * k, n, r.col, r.uv + b.xz * k * 0.1, origin);
            float3 nw = normalize(cross(normalize(qt - q), normalize(qb - q)));
            if (all(isfinite(nw))) nObj = normalize(mul(nw, (float3x3)_ObjectToWorld)); // world -> object normal (inverse of the line above)
        }
    }
    _Dst.Store3(at, asuint(pObj));
    if (_NrmOffset >= 0 && r.slot != 0xffffffffu) _Dst.Store3(id * _Stride + (uint)_NrmOffset, asuint(nObj));
}
