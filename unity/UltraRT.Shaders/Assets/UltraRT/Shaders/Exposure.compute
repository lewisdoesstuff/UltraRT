// UltraRT auto exposure (relight; docs/relight.md, "Auto exposure"). Driven by src/UltraRT/AutoExposure.cs.
//
//   Histogram  a log2-luminance histogram of the exposed part of the image, albedo * filtered lighting * keep +
//              specular, on every second pixel in x and y. Sky (t < 0) and fullbright pixels (lit weight < 0.5) are left
//              out: neither is exposed. Emission isn't measured either (it isn't exposed).
//   Adapt      one group: the mean log2 luminance of the pixels between two percentiles (bright specks and black
//              corners don't move it), optionally smoothed over time (the meter), the target EV (down to the key above
//              it; part of the way up to the dark key below that), clamped to [min, max] EV, and the adapted EV (separate
//              speeds up and down, exponential in EV, stopping a dead band short of the target). Clears the histogram.
//
// The result lives on the GPU only (no readback in the loop): _Exposure[0] = (exposure, EV, mean log2 lum, target EV),
// _Exposure[1] = (pixels counted, pixels in the percentile band, valid, meter = smoothed mean log2 lum). The denoiser's
// Composite reads [0].x one frame later (UltraRTExposure.hlsl).

#pragma kernel Histogram
#pragma kernel Adapt

#define BINS 64

Texture2D<float4>         _Filtered;    // denoised demodulated lighting (rgb)
Texture2D<float4>         _Albedo;
Texture2D<float4>         _Specular;    // rgb added, a = keep factor (only if _HasSpecular)
Texture2D<float4>         _NormalDepth; // w < 0: sky
Texture2D<uint4>          _LitWeight;   // PathTrace's _HybridLight: w & 0xFF = lit weight (0 = fullbright)
int                       _HasSpecular;
float4                    _Dim;         // w, h
float4                    _Range;       // x min log2 luminance, y bins per EV
RWStructuredBuffer<uint>  _Hist;        // BINS counters
RWStructuredBuffer<float4> _Exposure;   // see above
float4 _Params0; // x key (log2), y min EV, z max EV, w dt (s)
float  _UltraRTLinear; // global: 1 = _Filtered is linear lighting (relight's linear transport); measured in gamma units
float4 _Params1; // x speed up (1/s, exposure rising: into the dark), y speed down (1/s, into the light), z low fraction, w high fraction
float4 _Params2; // x snap (1 = jump to the target), y min pixels for a valid measurement, z exposure compensation (EV)
float4 _Params3; // x up strength (fraction of brightening), y dead band (EV), z meter speed (1/s, 0 = raw), w settle speed (1/s, 0 = not settling)
float4 _Params4; // x dark key (log2): meters between it and the key are left alone; darker ones are brightened towards it

float Luma(float3 c) { return dot(c, float3(0.2126, 0.7152, 0.0722)); }

groupshared uint gsBins[BINS];

[numthreads(16, 16, 1)]
void Histogram(uint3 id : SV_DispatchThreadID, uint gi : SV_GroupIndex)
{
    if (gi < BINS) gsBins[gi] = 0;
    GroupMemoryBarrierWithGroupSync();

    uint2 p = id.xy * 2;
    if (all(p < (uint2)_Dim.xy) && _NormalDepth[p].w >= 0.0 && (_LitWeight[p].w & 0xFFu) >= 128u)
    {
        float4 sp = _HasSpecular != 0 ? _Specular[p] : float4(0, 0, 0, 1);
        float3 lit = _UltraRTLinear > 0.5 ? pow(max(_Filtered[p].rgb, 0.0), 1.0 / 2.2) : _Filtered[p].rgb;
        float lum = Luma(_Albedo[p].rgb * lit * sp.a + sp.rgb);
        float bin = (log2(max(lum, 1e-8)) - _Range.x) * _Range.y;
        InterlockedAdd(gsBins[(uint)clamp(bin, 0.0, BINS - 1.0)], 1u);
    }
    GroupMemoryBarrierWithGroupSync();
    if (gi < BINS && gsBins[gi] != 0u) InterlockedAdd(_Hist[gi], gsBins[gi]);
}

[numthreads(BINS, 1, 1)]
void Adapt(uint gi : SV_GroupIndex)
{
    gsBins[gi] = _Hist[gi];
    GroupMemoryBarrierWithGroupSync();
    _Hist[gi] = 0u;
    if (gi != 0u) return;

    float total = 0.0;
    for (uint b = 0; b < BINS; b++) total += (float)gsBins[b];

    float4 prev = _Exposure[0];
    float4 info = _Exposure[1];
    bool valid = info.z > 0.5 && !any(isnan(prev)) && !any(isinf(prev));
    if (total < _Params2.y)
    {
        // Nothing to measure (all sky or fullbright): hold the current exposure.
        _Exposure[0] = valid ? prev : float4(1.0, 0.0, 0.0, 0.0);
        _Exposure[1] = float4(total, 0.0, valid ? 1.0 : 0.0, info.w);
        return;
    }

    float lo = total * _Params1.z, hi = total * _Params1.w;
    float acc = 0.0, sumW = 0.0, sumLog = 0.0;
    for (uint k = 0; k < BINS; k++)
    {
        float n = (float)gsBins[k];
        float take = clamp(min(acc + n, hi) - max(acc, lo), 0.0, n);
        sumLog += take * (_Range.x + (k + 0.5) / _Range.y);
        sumW += take;
        acc += n;
    }
    float meanLog = sumW > 0.0 ? sumLog / sumW : _Range.x;
    bool snap = _Params2.x > 0.5 || !valid;
    float dt = max(_Params0.w, 0.0);

    // Meter: the band mean, smoothed over time so single-frame noise never reaches the target.
    float meter = meanLog;
    if (!snap && _Params3.z > 0.0 && !isnan(info.w))
        meter = info.w + (meanLog - info.w) * (1.0 - exp(-dt * _Params3.z));

    // Target: above the key, the EV that maps the meter to the key (full darkening). Between the dark key and the key,
    // nothing: rooms keep the look of their lights. Below the dark key, part of the way (up strength) towards it, so
    // a very dark scene gets readable but stays darker than a lit one.
    float down = _Params0.x - meter, up = _Params4.x - meter;
    float shaped = down < 0.0 ? down : (up > 0.0 ? up * _Params3.x : 0.0);
    float target = clamp(shaped + _Params2.z, _Params0.y, _Params0.z);

    float ev = prev.y;
    if (snap)
        ev = target;
    else
    {
        float err = target - ev;
        float speed = err > 0.0 ? _Params1.x : _Params1.y;
        float band = _Params3.y;
        if (_Params3.w > 0.0) { speed = max(speed, _Params3.w); band = 0.0; } // settling after a reset
        // Dead band: aim band EV short of the target, so a wandering target within the band leaves the exposure alone.
        float aim = sign(err) * max(abs(err) - band, 0.0);
        ev += aim * (1.0 - exp(-dt * speed));
    }
    ev = clamp(ev, _Params0.y, _Params0.z);
    _Exposure[0] = float4(exp2(ev), ev, meanLog, target);
    _Exposure[1] = float4(total, sumW, 1.0, meter);
}
