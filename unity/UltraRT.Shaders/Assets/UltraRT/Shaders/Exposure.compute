// UltraRT auto exposure (relight; docs/relight.md, "Auto exposure"). Driven by src/UltraRT/AutoExposure.cs.
//
//   Histogram  a log2-luminance histogram of the exposed part of the image, albedo * filtered lighting * keep +
//              specular, on every second pixel in x and y. Sky (t < 0) and fullbright pixels (lit weight < 0.5) are left
//              out: neither is exposed. Emission isn't measured either (it isn't exposed).
//   Adapt      one group: the mean log2 luminance of the pixels between two percentiles (bright specks and black
//              corners don't move it), optionally smoothed over time (the meter), the target EV (down to the key above
//              it; part of the way up to the dark key below that), clamped to [min, max] EV, and the adapted EV (separate
//              speeds up and down, exponential in EV, stopping a dead band short of the target). Clears the histogram.
//
// The result lives on the GPU only (no readback in the loop): _Exposure[0] = (exposure, EV, mean log2 lum, target EV),
// _Exposure[1] = (pixels counted, pixels in the percentile band, valid, meter = smoothed mean log2 lum),
// _Exposure[2] = game match (game band mean, RT band mean, correction EV, near pixels), _Exposure[3] = colour match
// (per-channel gain on the lit part, w = 1 when valid). The denoiser's Composite reads [0].x and [3] one frame later
// (UltraRTExposure.hlsl).

#pragma kernel Histogram
#pragma kernel Adapt

#define BINS 64

Texture2D<float4>         _Filtered;    // denoised demodulated lighting (rgb)
Texture2D<float4>         _Albedo;
Texture2D<float4>         _Specular;    // rgb added, a = keep factor (only if _HasSpecular)
Texture2D<float4>         _NormalDepth; // w < 0: sky
Texture2D<uint4>          _LitWeight;   // PathTrace's _HybridLight: w & 0xFF = lit weight (0 = fullbright)
int                       _HasSpecular;
float4                    _Dim;         // w, h
float4                    _Range;       // x min log2 luminance, y bins per EV
RWStructuredBuffer<uint>  _Hist;        // BINS counters
RWStructuredBuffer<float4> _Exposure;   // see above
float4 _Params0; // x key (log2), y min EV, z max EV, w dt (s)
float  _UltraRTLinear; // global: 1 = _Filtered is linear lighting (relight's linear transport); measured in gamma units
float4 _Params1; // x speed up (1/s, exposure rising: into the dark), y speed down (1/s, into the light), z low fraction, w high fraction
float4 _Params2; // x snap (1 = jump to the target), y min pixels for a valid measurement, z exposure compensation (EV)
float4 _Params3; // x up strength (fraction of brightening), y dead band (EV), z meter speed (1/s, 0 = raw), w settle speed (1/s, 0 = not settling)
float4 _Params4; // x dark key (log2): meters between it and the key are left alone; darker ones are brightened towards it
// Volumetric haze (docs/volumetrics.md), last frame's low-res in-scattering, added to the metered luminance the way the
// volumetric composite adds it to the picture (linear, times the exposure), so a hazy scene is not lifted as if it were dark.
Texture2D<float4> _VolHaze;
float4 _VolHazeParams;           // x low-res width, y height, z scale (in-scatter strength x meter weight), w 1 = on

// Game match (docs/relight.md, "Game match"): the game's own frame before the RT composite, metered at the same pixels.
Texture2D<float4> _GameColor;
float4 _GameMap;  // xy: game uv = 0.5 + (trace uv - 0.5) * xy (the guard band); z: 1 = flip y; 0 = off
float4 _GameFog;  // x 1 = fog on, y mode (1 linear, 2 exp, 3 exp2), z start (linear) or density, w end
float4 _Params5;  // x match strength up (RT darker than the game), y down, z dead band (EV), w max game fog factor
// Colour match (docs/relight.md, "Area colour"): mean colour of the same near pixels, RT (pre-haze) and game, as fixed
// point sums after the three histograms (_Hist[3 * BINS + 0..5]).
float4 _Params6;  // x strength (0 = off), y dead band (log2 per channel), z max correction (log2 per channel),
                  // w 1 = light fit statistics: linear colour sums of RT and game at the near pixels (_Hist[3 * BINS + 6..11],
                  // means in _Exposure[4] / [5]; docs/lighting-overrides.md, "Fit")
#define LIN_FIXED 1024.0
#define LIN_MAX 4.0
#define COLOR_FIXED 256.0
#define COLOR_MAX 4.0
#define COLOR_MIN_SHARE 0.15 // channels below this share of the brightest one (in both images) are corrected proportionally less

float Luma(float3 c) { return dot(c, float3(0.2126, 0.7152, 0.0722)); }

float GameFogFactor(float d)
{
    if (_GameFog.x < 0.5) return 0.0;
    if (_GameFog.y < 1.5) return saturate((d - _GameFog.z) / max(_GameFog.w - _GameFog.z, 1e-3));
    float k = _GameFog.z * d;
    return 1.0 - (_GameFog.y < 2.5 ? exp(-k) : exp(-k * k));
}

groupshared uint gsBins[BINS];
groupshared uint gsNear[BINS];
groupshared uint gsGame[BINS];
groupshared uint gsCol[6];
groupshared uint gsLin[6];

[numthreads(16, 16, 1)]
void Histogram(uint3 id : SV_DispatchThreadID, uint gi : SV_GroupIndex)
{
    if (gi < BINS) { gsBins[gi] = 0; gsNear[gi] = 0; gsGame[gi] = 0; }
    if (gi < 6) { gsCol[gi] = 0; gsLin[gi] = 0; }
    GroupMemoryBarrierWithGroupSync();

    uint2 p = id.xy * 2;
    if (all(p < (uint2)_Dim.xy) && _NormalDepth[p].w >= 0.0 && (_LitWeight[p].w & 0xFFu) >= 128u)
    {
        float4 sp = _HasSpecular != 0 ? _Specular[p] : float4(0, 0, 0, 1);
        float3 lit = _UltraRTLinear > 0.5 ? pow(max(_Filtered[p].rgb, 0.0), 1.0 / 2.2) : _Filtered[p].rgb;
        float lum = Luma(_Albedo[p].rgb * lit * sp.a + sp.rgb);
        if (_VolHazeParams.w > 0.5)
        {
            // displayed = ((e lum)^2.2 + e S)^(1/2.2); metered = displayed / e = (lum^2.2 + S e^-1.2)^(1/2.2)
            uint2 q = min((uint2)(((float2)p + 0.5) / _Dim.xy * _VolHazeParams.xy), (uint2)_VolHazeParams.xy - 1u);
            float e = _Exposure[0].x;
            e = (e > 0.0 && !isinf(e)) ? e : 1.0;
            float haze = Luma(max(_VolHaze[q].rgb, 0.0)) * _VolHazeParams.z * pow(e, -1.2);
            lum = pow(pow(max(lum, 0.0), 2.2) + haze, 1.0 / 2.2);
        }
        float bin = (log2(max(lum, 1e-8)) - _Range.x) * _Range.y;
        InterlockedAdd(gsBins[(uint)clamp(bin, 0.0, BINS - 1.0)], 1u);

        if (_GameMap.x > 0.0)
        {
            float2 uv = 0.5 + (((float2)p + 0.5) / _Dim.xy - 0.5) * _GameMap.xy;
            if (_GameMap.z > 0.5) uv.y = 1.0 - uv.y;
            uint gw, gh;
            _GameColor.GetDimensions(gw, gh);
            if (all(uv >= 0.0) && all(uv < 1.0) && GameFogFactor(_NormalDepth[p].w) <= _Params5.w)
            {
                // Pre-haze RT luminance against the game's colour (its own lighting, display units).
                float3 colRT = _Albedo[p].rgb * lit * sp.a + sp.rgb;
                float3 colGame = _GameColor[(uint2)(uv * float2(gw, gh))].rgb;
                float lumRT = Luma(colRT);
                float lumGame = Luma(colGame);
                if (_Params6.x > 0.0 || _Params6.w > 0.5) // colour match, or the light fit's display means
                {
                    uint3 qr = (uint3)(clamp(colRT, 0.0, COLOR_MAX) * COLOR_FIXED + 0.5);
                    uint3 qg = (uint3)(clamp(colGame, 0.0, COLOR_MAX) * COLOR_FIXED + 0.5);
                    InterlockedAdd(gsCol[0], qr.r); InterlockedAdd(gsCol[1], qr.g); InterlockedAdd(gsCol[2], qr.b);
                    InterlockedAdd(gsCol[3], qg.r); InterlockedAdd(gsCol[4], qg.g); InterlockedAdd(gsCol[5], qg.b);
                }
                if (_Params6.w > 0.5)
                {
                    // Light fit: linear in every light's intensity (the albedo and keep factor in linear units, the lighting
                    // as traced; reflections taken as they are). The game's colour decoded to linear.
                    float3 litL = _UltraRTLinear > 0.5 ? max(_Filtered[p].rgb, 0.0) : pow(max(_Filtered[p].rgb, 0.0), 2.2);
                    float3 linRT = pow(max(_Albedo[p].rgb * sp.a, 0.0), 2.2) * litL + pow(max(sp.rgb, 0.0), 2.2);
                    float3 linGame = pow(max(colGame, 0.0), 2.2);
                    uint3 lr = (uint3)(clamp(linRT, 0.0, LIN_MAX) * LIN_FIXED + 0.5);
                    uint3 lg = (uint3)(clamp(linGame, 0.0, LIN_MAX) * LIN_FIXED + 0.5);
                    InterlockedAdd(gsLin[0], lr.r); InterlockedAdd(gsLin[1], lr.g); InterlockedAdd(gsLin[2], lr.b);
                    InterlockedAdd(gsLin[3], lg.r); InterlockedAdd(gsLin[4], lg.g); InterlockedAdd(gsLin[5], lg.b);
                }
                float bn = (log2(max(lumRT, 1e-8)) - _Range.x) * _Range.y;
                float bg = (log2(max(lumGame, 1e-8)) - _Range.x) * _Range.y;
                InterlockedAdd(gsNear[(uint)clamp(bn, 0.0, BINS - 1.0)], 1u);
                InterlockedAdd(gsGame[(uint)clamp(bg, 0.0, BINS - 1.0)], 1u);
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (gi < BINS)
    {
        if (gsBins[gi] != 0u) InterlockedAdd(_Hist[gi], gsBins[gi]);
        if (gsNear[gi] != 0u) InterlockedAdd(_Hist[BINS + gi], gsNear[gi]);
        if (gsGame[gi] != 0u) InterlockedAdd(_Hist[2 * BINS + gi], gsGame[gi]);
    }
    if (gi < 6 && gsCol[gi] != 0u) InterlockedAdd(_Hist[3 * BINS + gi], gsCol[gi]);
    if (gi < 6 && gsLin[gi] != 0u) InterlockedAdd(_Hist[3 * BINS + 6 + gi], gsLin[gi]);
}

// Mean log2 of the [lo, hi] percentile band of one histogram (offset `base` in gsAll).
groupshared uint gsAll[3 * BINS];
float BandMean(uint base, float total, out float sumW)
{
    float lo = total * _Params1.z, hi = total * _Params1.w;
    float acc = 0.0, sumLog = 0.0;
    sumW = 0.0;
    for (uint k = 0; k < BINS; k++)
    {
        float n = (float)gsAll[base + k];
        float take = clamp(min(acc + n, hi) - max(acc, lo), 0.0, n);
        sumLog += take * (_Range.x + (k + 0.5) / _Range.y);
        sumW += take;
        acc += n;
    }
    return sumW > 0.0 ? sumLog / sumW : _Range.x;
}

[numthreads(BINS, 1, 1)]
void Adapt(uint gi : SV_GroupIndex)
{
    gsBins[gi] = _Hist[gi];
    gsAll[gi] = gsBins[gi];
    gsAll[BINS + gi] = _Hist[BINS + gi];
    gsAll[2 * BINS + gi] = _Hist[2 * BINS + gi];
    if (gi < 6) { gsCol[gi] = _Hist[3 * BINS + gi]; gsLin[gi] = _Hist[3 * BINS + 6 + gi]; }
    GroupMemoryBarrierWithGroupSync();
    _Hist[gi] = 0u;
    _Hist[BINS + gi] = 0u;
    _Hist[2 * BINS + gi] = 0u;
    if (gi < 6) { _Hist[3 * BINS + gi] = 0u; _Hist[3 * BINS + 6 + gi] = 0u; }
    if (gi != 0u) return;

    if (_Params6.w > 0.5)
    {
        // Light fit statistics (docs/lighting-overrides.md, "Fit"): linear mean colour of RT and game at the near pixels.
        float n = 0.0;
        for (uint q = 0; q < BINS; q++) n += (float)gsAll[BINS + q];
        float inv = n > 0.0 ? 1.0 / (LIN_FIXED * n) : 0.0;
        _Exposure[4] = float4(float3(gsLin[0], gsLin[1], gsLin[2]) * inv, n);
        _Exposure[5] = float4(float3(gsLin[3], gsLin[4], gsLin[5]) * inv, n);
        // ... and the display-unit means (the colour match's sums): the fit's target is the game's look, not its energy.
        float invD = n > 0.0 ? 1.0 / (COLOR_FIXED * n) : 0.0;
        _Exposure[6] = float4(float3(gsCol[0], gsCol[1], gsCol[2]) * invD, n);
        _Exposure[7] = float4(float3(gsCol[3], gsCol[4], gsCol[5]) * invD, n);
    }

    float total = 0.0;
    for (uint b = 0; b < BINS; b++) total += (float)gsBins[b];

    float4 prev = _Exposure[0];
    float4 info = _Exposure[1];
    bool valid = info.z > 0.5 && !any(isnan(prev)) && !any(isinf(prev));
    if (total < _Params2.y)
    {
        // Nothing to measure (all sky or fullbright): hold the current exposure.
        _Exposure[0] = valid ? prev : float4(1.0, 0.0, 0.0, 0.0);
        _Exposure[1] = float4(total, 0.0, valid ? 1.0 : 0.0, info.w);
        return; // _Exposure[3] (colour match) is held too

    }

    float lo = total * _Params1.z, hi = total * _Params1.w;
    float acc = 0.0, sumW = 0.0, sumLog = 0.0;
    for (uint k = 0; k < BINS; k++)
    {
        float n = (float)gsBins[k];
        float take = clamp(min(acc + n, hi) - max(acc, lo), 0.0, n);
        sumLog += take * (_Range.x + (k + 0.5) / _Range.y);
        sumW += take;
        acc += n;
    }
    float meanLog = sumW > 0.0 ? sumLog / sumW : _Range.x;
    bool snap = _Params2.x > 0.5 || !valid;
    float dt = max(_Params0.w, 0.0);

    // Meter: the band mean, smoothed over time so single-frame noise never reaches the target.
    float meter = meanLog;
    if (!snap && _Params3.z > 0.0 && !isnan(info.w))
        meter = info.w + (meanLog - info.w) * (1.0 - exp(-dt * _Params3.z));

    // Target: above the key, the EV that maps the meter to the key (full darkening). Between the dark key and the key,
    // nothing: rooms keep the look of their lights. Below the dark key, part of the way (up strength) towards it, so
    // a very dark scene gets readable but stays darker than a lit one.
    float down = _Params0.x - meter, up = _Params4.x - meter;
    float shaped = down < 0.0 ? down : (up > 0.0 ? up * _Params3.x : 0.0);
    float target = shaped + _Params2.z;

    // Game match: the game's brightness at the same (near) pixels against the RT image's, as it will be exposed. Beyond
    // the dead band, part of the difference moves the target (more strongly up than down: the RT look may stay brighter).
    float4 matchInfo = _Exposure[2];
    float corr = 0.0;
    float nearN = 0.0;
    for (uint m = 0; m < BINS; m++) nearN += (float)gsAll[BINS + m];
    if ((_Params5.x > 0.0 || _Params5.y > 0.0) && nearN >= 0.25 * total)
    {
        float wN, wG;
        float rtMean = BandMean(BINS, nearN, wN);
        float gameMean = BandMean(2 * BINS, nearN, wG);
        float diff = gameMean - (rtMean + target);
        float ex = sign(diff) * max(abs(diff) - _Params5.z, 0.0);
        float rawCorr = ex * (ex > 0.0 ? _Params5.x : _Params5.y);
        // Smoothed like the meter, so the target doesn't follow single-frame noise.
        corr = (snap || isnan(matchInfo.z)) ? rawCorr : matchInfo.z + (rawCorr - matchInfo.z) * (1.0 - exp(-dt * max(_Params3.z, 1.0)));
        matchInfo = float4(gameMean, rtMean, corr, nearN);
    }
    else
        matchInfo = float4(0.0, 0.0, 0.0, nearN);
    target = clamp(target + corr, _Params0.y, _Params0.z);

    float ev = prev.y;
    if (snap)
        ev = target;
    else
    {
        float err = target - ev;
        float speed = err > 0.0 ? _Params1.x : _Params1.y;
        float band = _Params3.y;
        if (_Params3.w > 0.0) { speed = max(speed, _Params3.w); band = 0.0; } // settling after a reset
        // Dead band: aim band EV short of the target, so a wandering target within the band leaves the exposure alone.
        float aim = sign(err) * max(abs(err) - band, 0.0);
        ev += aim * (1.0 - exp(-dt * speed));
    }
    ev = clamp(ev, _Params0.y, _Params0.z);
    _Exposure[0] = float4(exp2(ev), ev, meanLog, target);
    _Exposure[1] = float4(total, sumW, 1.0, meter);
    _Exposure[2] = matchInfo;

    // Colour match: the game's mean colour at the same near pixels against the RT image's, each normalised to its own
    // luminance (so this is hue and saturation only; brightness is the game match above). Per channel, beyond a dead
    // band, a share of the log2 difference becomes a gain on the lit part, clamped, then rescaled so the RT mean keeps
    // its channel average (not its luminance: green carries 72% of luminance, so keeping it pushed a red room's green
    // back up). Levels whose lighting the RT image already reproduces (1-1) stay inside the band.
    float4 bal = _Exposure[3];
    bool balValid = valid && bal.w > 0.5 && !any(isnan(bal)) && !any(isinf(bal));
    float3 rawGain = 1.0;
    if (_Params6.x > 0.0 && nearN >= 0.25 * total)
    {
        float3 rt = float3(gsCol[0], gsCol[1], gsCol[2]) / COLOR_FIXED / nearN;
        float3 game = float3(gsCol[3], gsCol[4], gsCol[5]) / COLOR_FIXED / nearN;
        float lr = Luma(rt), lg = Luma(game);
        if (lr > 1e-3 && lg > 1e-3)
        {
            float3 d = log2(max(game / lg, 1e-3)) - log2(max(rt / lr, 1e-3));
            float3 ex = sign(d) * max(abs(d) - _Params6.y, 0.0);
            // A channel that is nearly empty in both images (0-5's blue, 6-2's green) only matters in proportion: its log
            // ratio is large but meaningless, and correcting it would tint lit objects of another colour there.
            float3 share = max(rt / max(max(rt.r, rt.g), max(rt.b, 1e-4)), game / max(max(game.r, game.g), max(game.b, 1e-4)));
            ex *= saturate(share / COLOR_MIN_SHARE);
            rawGain = exp2(clamp(ex * _Params6.x, -_Params6.z, _Params6.z));
            rawGain *= (rt.r + rt.g + rt.b) / max(dot(rawGain, rt), 1e-4);
        }
    }
    float3 gain = (snap || !balValid) ? rawGain : bal.rgb + (rawGain - bal.rgb) * (1.0 - exp(-dt * max(_Params3.z, 1.0)));
    _Exposure[3] = float4(gain, 1.0);
}
