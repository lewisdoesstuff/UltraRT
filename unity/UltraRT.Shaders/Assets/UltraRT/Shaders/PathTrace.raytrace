// Lighting pass: primary hit, shadowed direct light using ULTRAKILL's own light model, and one diffuse
// bounce that picks up emissive surfaces plus one shadowed light sample at the bounce.
// Writes a composited image plus demodulated G-buffer channels for the denoiser.
// Glossy and REFLECTION surfaces also trace one reflection ray (docs/reflections.md).
#pragma max_recursion_depth 1

#include "UltraRTCommon.hlsl"
#include "UltraRTMaterial.hlsl"

RaytracingAccelerationStructure _Scene;
#include "UltraRTPortals.hlsl" // TraceScene: rays follow portals (docs/portals.md)
// NOTE: Unity ray tracing shaders support at most 8 UAVs; a 9th makes DispatchRays fail silently. This shader binds
// exactly 8: the 7 below plus _ReservoirCur (UltraRTLights.hlsl). Albedo and emission share _Surface to make room for
// _Reflection. Add outputs only by packing.
RWTexture2D<float4> _Output;      // composited (albedo * lighting + emission + reflections); also the accumulation history (ARGBHalf)
RWTexture2D<float4> _Radiance;    // demodulated lighting (not multiplied by albedo)
RWTexture2D<uint4>  _Surface;     // packed albedo, emission and reflection material (UltraRTMaterial.hlsl, PackSurface)
RWTexture2D<float4> _NormalDepth; // xyz world normal, w = hit distance (< 0 = sky)
RWTexture2D<int2>   _InstanceId;  // RGInt: x InstanceIndex() (-1 = sky), y packed world-space motion (PackMotion, 0 = static)
RWTexture2D<uint4>  _HybridLight;  // hybrid: packed halves: unshadowed direct rgb, shadowed direct rgb, lit weight
RWTexture2D<float4> _Reflection;  // rgb reflected radiance; a: reflection hit distance (sky: 1000), -1 = not traced

float4x4 _InvViewProj;
float4   _CamPos;
int      _Mode;          // 0 full, 1 direct only, 2 indirect only, 3 hybrid numerator
float    _GIStrength;    // hybrid: how much of the RT bounce to add on top of the game's fills
uint     _FrameIndex;
uint     _AccumFrames;   // frames already accumulated (0 = reset)

// Light buffers (_Lights, _LightMasks, _LightCount) and light sampling state: UltraRTLights.hlsl.

// Sky (_SkyColor, _SkyTex, SkyRadiance, sky light sampling): UltraRTSky.hlsl.
float4   _Ambient;        // the game's ambient term (2 * RenderSettings.ambientLight)
float    _PrimaryAmbient; // how much of _Ambient to add at the primary hit (art knob)
float    _BounceAmbient;  // how much of _Ambient to add at the bounce hit (stand-in for further bounces)
float    _LightScale;
float    _EmissionScale;
// Reflections: x enabled, y global specular weight, z global reflection strength, w minimum weight (luminance of the
// specular term) worth a ray. Pixels below it skip the ray, so the cost follows glossy coverage.
float4   _ReflParams;
float    _ReflMaxRadiance; // firefly clamp (luminance) for glossy reflections; mirrors are not clamped
// Reflections v2 (docs/reflections.md): x radiance cache at reflection hits (0 off, 1 by footprint, 2 always),
// y footprint threshold (fraction of a cache cell), z hybrid: replace the game's cubemap (0/1). Unbound = all off.
float4   _ReflCache;

// ---------------------------------------------------------------- rng

uint Pcg(inout uint s)
{
    s = s * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
    return (w >> 22u) ^ w;
}

float Rand(inout uint s) { return Pcg(s) * (1.0 / 4294967296.0); }

float3 CosineHemisphere(float3 n, float u1, float u2)
{
    float r = sqrt(u1);
    float phi = 6.28318530718 * u2;
    float3 t = abs(n.y) < 0.999 ? normalize(cross(n, float3(0, 1, 0))) : float3(1, 0, 0);
    float3 b = cross(n, t);
    return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - u1)));
}

// GGX distribution of visible normals (Heitz 2018), tangent space with z = normal. Ve: view direction (towards the eye).
float3 SampleGgxVndf(float3 Ve, float alpha, float u1, float u2)
{
    float3 Vh = normalize(float3(alpha * Ve.x, alpha * Ve.y, Ve.z));
    float lensq = Vh.x * Vh.x + Vh.y * Vh.y;
    float3 T1 = lensq > 0.0 ? float3(-Vh.y, Vh.x, 0.0) * rsqrt(lensq) : float3(1.0, 0.0, 0.0);
    float3 T2 = cross(Vh, T1);
    float r = sqrt(u1);
    float phi = 6.28318530718 * u2;
    float t1 = r * cos(phi);
    float t2 = r * sin(phi);
    float s = 0.5 * (1.0 + Vh.z);
    t2 = (1.0 - s) * sqrt(max(0.0, 1.0 - t1 * t1)) + s * t2;
    float3 Nh = t1 * T1 + t2 * T2 + sqrt(max(0.0, 1.0 - t1 * t1 - t2 * t2)) * Vh;
    return normalize(float3(alpha * Nh.x, alpha * Nh.y, max(1e-6, Nh.z)));
}

// Reflection direction for roughness r: the exact mirror direction below 0.03, else a GGX (alpha = r^2) VNDF sample.
// The estimator is the plain radiance along that direction: the Fresnel term is applied by the composite, and the
// G2/G1 factor of VNDF sampling is taken as 1. Samples that end up below the surface fall back to the mirror direction.
float3 ReflectionDirection(float3 n, float3 dir, float roughness, inout uint rng)
{
    float3 mirror = reflect(dir, n);
    if (roughness < 0.03) return mirror;
    float3 t = abs(n.y) < 0.999 ? normalize(cross(n, float3(0, 1, 0))) : float3(1, 0, 0);
    float3 b = cross(n, t);
    float3 V = -dir;
    float3 Ve = float3(dot(V, t), dot(V, b), max(dot(V, n), 1e-4));
    float3 h = SampleGgxVndf(Ve, max(roughness * roughness, 1e-3), Rand(rng), Rand(rng));
    float3 H = normalize(t * h.x + b * h.y + n * h.z);
    float3 L = reflect(dir, H);
    return dot(L, n) > 1e-3 ? L : mirror;
}

// ---------------------------------------------------------------- lights

#include "UltraRTLights.hlsl"
#include "UltraRTCache.hlsl" // radiance cache lookups (read-only: no UAVs)
#include "UltraRTSky.hlsl"   // sky radiance and sky light sampling (SRVs only)

// The game's lighting at a point: same lights and falloff, but no shadows (the game has none) and its full ambient.
// Used as the denominator of the ratio composite: game colour * (RT lighting / game lighting).
float3 UnshadowedFrom(int i, float3 p, float3 n, uint layer)
{
    float4 l0 = _Lights[i * 4];
    float4 l1 = _Lights[i * 4 + 1];
    if (((_LightMasks[i] >> layer) & 1u) == 0u) return 0;
    bool local = l0.w != 0.0;
    float3 toL = local ? l0.xyz - p : l0.xyz;
    float d2 = max(dot(toL, toL), 1e-6);
    float d = sqrt(d2);
    float3 L = toL / d;
    float ndl = dot(n, L);
    if (ndl <= 0.0) return 0;
    float atten = 1.0;
    if (local)
    {
        float4 l2 = _Lights[i * 4 + 2];
        float4 l3 = _Lights[i * 4 + 3];
        float r = max(l0.w, 1e-6);
        atten = 1.0 / (1.0 + d2 * 25.0 / (r * r));
        atten *= saturate((max(dot(L, -l2.xyz), 0.0) - l3.x) * l3.y);
        atten *= saturate(2.0 - d / r);
    }
    return l1.rgb * (atten * ndl);
}

float3 UnshadowedAll(float3 p, float3 n, uint layer)
{
    float3 sum = 0;
    for (int i = 0; i < _LightCount; i++) sum += UnshadowedFrom(i, p, n, layer);
    return sum * _LightScale;
}
// ---------------------------------------------------------------- reflections

// Lighting arriving at a reflection hit. With the radiance cache, a hit whose reflection footprint (lobe spread plus
// the pixel's footprint at the virtual image distance) covers at least _ReflCache.y of a cache cell reads the cell's
// total lighting: no shadow ray, no light-selection speckle, and multi-bounce light. Smaller footprints (mirrors, sharp
// glossy) keep the 1-sample direct light, for sharp shadows in the reflection, plus the cell's indirect light. A missing
// or unconverged cell falls back to the old estimate (direct + ambient only). Hybrid scales the indirect part by
// _GIStrength, like the bounce it adds to the game's colour.
float3 ReflectionHitLight(float3 hp, RayPayload h, float footprint, inout uint rng)
{
    float3 total, indirect;
    bool cached = _ReflCache.x > 0.5 && CacheLookup(hp, h.normal, total, indirect);
    float giW = _Mode == 3 ? _GIStrength : 1.0;
    float3 light;
    if (cached && (_ReflCache.x > 1.5 || footprint >= CacheCellSize(CacheLevel(hp)) * _ReflCache.y))
        light = total - indirect * (1.0 - giW);
    else
        light = DirectOne(hp, h.normal, PayloadLayer(h), rng) + (cached ? indirect * giW : 0.0);
    return light + ToLight(_Ambient.rgb) * _BounceAmbient * RelightAmbientScale();
}

// Radiance arriving along one reflection ray: the hit's albedo x lighting (ReflectionHitLight) + its emission (in
// full: emissive light sampling only covers the diffuse lobe), or the sky. In display (gamma) units: with linear
// transport the hit's lighting is converted per sample. Sky walls report a miss, so they reflect as
// sky too. dist: hit distance, or 1000 for the sky (the virtual image point). spread: lobe spread (radians, roughly
// alpha); pixelAngle: one trace pixel's angle; t: primary hit distance (for the footprint).
float3 TraceReflection(float3 pos, float3 n, float3 L, bool glossy, float spread, float pixelAngle, float t, inout uint rng, out float dist)
{
    RayDesc r;
    r.Origin = pos + n * 0.02;
    r.Direction = L;
    r.TMin = 0.0;
    r.TMax = 1.0e4;
    RayPayload h;
    PortalPath rpath; // r: the last segment after portals; per-texel detail at the hit (docs/materials.md)
    TraceScene(RAY_FLAG_CULL_BACK_FACING_TRIANGLES, ULTRART_MASK_SCENE, ULTRART_FLAG_DETAIL, r, h, rpath);
    float travelled = rpath.travelled;
    float3 c;
    if (h.t < 0.0)
    {
        dist = 1000.0;
        c = SkyRadiance(r.Direction);
    }
    else
    {
        float ht = travelled + h.t;
        dist = ht;
        float3 hp = r.Origin + r.Direction * h.t;
        float footprint = ht * spread + (t + ht) * pixelAngle;
        float3 hitLight = ReflectionHitLight(hp, h, footprint, rng);
        c = PayloadEmission(h) * _EmissionScale + h.albedo * lerp(1.0, LightToDisplay(hitLight), h.alpha);
    }
    c = max(c, 0.0); // also drops NaN
    if (glossy)
    {
        float l = dot(c, float3(0.2126, 0.7152, 0.0722));
        if (l > _ReflMaxRadiance) c *= _ReflMaxRadiance / l;
    }
    return c;
}

// ---------------------------------------------------------------- water and glass (docs/reflections.md, "Water and glass")

// Transparent surfaces (instance mask 0x10) are invisible to every other ray. In hybrid and denoised modes
// (_TransParams.y = 1, only while a water/glass instance is active) the end of RayGen finds the nearest water or glass
// surface in front of the opaque hit and traces its mirror reflection (procedural ripples on water), writing
// _Output = (reflected radiance, distance to the transparent surface; < 0 = none) instead of the composited colour,
// which those modes never read. No ninth UAV and no second DispatchRays (a second dispatch rebuilds the shader table:
// measured +0.2-0.3 ms of frame time). TransparentOverlay.shader applies it with Fresnel right after the game draws
// the surface, so particles in front still cover it.
#include "UltraRTWater.hlsl"

// x: lobe spread used for the reflection hit's cache footprint test (large = always shade from the radiance cache:
// smooth, no shadow-ray noise; there is no temporal filter on this pass). y: 1 = trace transparents into _Output.
float4 _TransParams;

float4 TraceTransparent(RayDesc ray, float opaqueT, inout uint rng)
{
    ray.TMin = 0.0;
    ray.TMax = opaqueT > 0.0 ? opaqueT + 0.05 : 1.0e5;
    RayPayload p = (RayPayload)0;
    p.t = -1.0;
    TraceRay(_Scene, RAY_FLAG_CULL_BACK_FACING_TRIANGLES, ULTRART_MASK_TRANSPARENT, 0, 1, 0, ray, p);
    if (p.t < 0.0) return float4(0, 0, 0, -1);

    float3 pos = ray.Origin + ray.Direction * p.t;
    float3 ng = p.normal; // faces the ray
    SurfaceMaterial mat = MaterialFromPayload(p.material, p.flags);
    float3 n = mat.cls == 13u ? WaterNormal(ng, pos, p.t) : ng; // 13 = Wet: water
    float3 L = reflect(ray.Direction, n);
    if (dot(L, ng) < 0.02) L = reflect(ray.Direction, ng);
    float dist;
    float3 lr = TraceReflection(pos, ng, L, false, _TransParams.x, 0.0, p.t, rng, dist);
    return float4(lr, p.t);
}

// ---------------------------------------------------------------- ray generation

[shader("raygeneration")]
void RayGen()
{
    uint2 id = DispatchRaysIndex().xy;
    uint2 dim = DispatchRaysDimensions().xy;
    uint rng = (id.x * 1973u + id.y * 9277u + _FrameIndex * 26699u) | 1u;
    g_ShadowRng = HashU32(rng);

    // Jitter within the pixel only while accumulating, so a single frame stays stable.
    float2 jitter = _AccumFrames > 0 ? float2(Rand(rng), Rand(rng)) : float2(0.5, 0.5);
    float2 ndc = ((float2)id + jitter) / (float2)dim * 2.0 - 1.0;
    float4 farPt = mul(_InvViewProj, float4(ndc, 1.0, 1.0));
    farPt.xyz /= farPt.w;

    RayDesc ray;
    ray.Origin = _CamPos.xyz;
    ray.Direction = normalize(farPt.xyz - _CamPos.xyz);
    ray.TMin = 0.0;
    ray.TMax = 1.0e5;

    RayPayload p;
    // Hybrid with reflections: ask the hit shader for the game's cubemap term (UltraRTMaterial.hlsl, game cubemap).
    bool wantGameCube = _Mode == 3 && _ReflParams.x > 0.5 && _ReflCache.z > 0.5;
    uint inFlags = ULTRART_PAYLOAD_WANT_MOTION | ULTRART_FLAG_DETAIL; // the hit returns its motion in p.motion; per-texel detail
    if (wantGameCube) inFlags |= ULTRART_FLAG_GAMECUBE;
    // Through portals the ray continues on the far side (UltraRTPortals.hlsl): from here on `ray` is the last segment, so
    // shading uses the real hit point and direction. The G-buffer gets the camera-side ("virtual") view of the hit: path
    // length, normal and motion as seen through the portals, so the denoiser, ReSTIR and the reflection filter reproject
    // it like any other surface (portals are rigid).
    float3 camDir = ray.Direction;
    RayDesc camRay = ray;
    PortalPath path;
    TraceScene(RAY_FLAG_CULL_BACK_FACING_TRIANGLES, ULTRART_MASK_SCENE, inFlags, ray, p, path);

    float3 c, lighting, albedo, emission;
    if (p.t < 0.0)
    {
        c = SkyRadiance(ray.Direction);
        lighting = ToLight(c); // lighting space; the composites convert back
        albedo = 1;
        emission = 0;
        _NormalDepth[id] = float4(0, 0, 0, -1);
        _HybridLight[id] = uint4(0, 0, 0, 0);
        _InstanceId[id] = int2(-1, 0);
        _Surface[id] = PackSurface(albedo, emission, 0u, 0u);
        _Reflection[id] = float4(0, 0, 0, -1);
        RestirWriteEmpty(id, dim);
    }
    else
    {
        float3 pos = ray.Origin + ray.Direction * p.t;
        float3 n = p.normal; // shading normal: per-texel detail where the material has it (docs/materials.md)
        // The interpolated vertex normal: ray offsets and the hemisphere test, the radiance cache lookup, and in hybrid the
        // game's own lighting (the shadow ratio's denominator).
        bool detail = (p.flags & ULTRART_FLAG_DETAIL) != 0u;
        float3 nv = detail ? UnpackOct24(p.primitive) : n;
        if (dot(nv, ray.Direction) > 0.0) nv = -nv; // faces the ray, like p.normal
        bool hybridDetail = detail && _Mode == 3;
        float3 nLight = hybridDetail ? nv : n; // the normal DirectLighting samples and stores reservoirs with
        uint layer = PayloadLayer(p);
        uint motion = p.motion;
        float tTotal = path.travelled + p.t;
        g_PrimaryMotion = UnpackMotion(motion); // ReSTIR temporal reuse reprojects pos + motion
        if (path.hops > 0u)
        {
            g_PrimaryMotion = PortalToVirtual(path, g_PrimaryMotion);
            motion = PackMotion(g_PrimaryMotion);
            g_PrimaryVirtual = true; // ReSTIR: reproject and store the camera-side point (UltraRTLights.hlsl)
            g_PrimaryVirtualPos = _CamPos.xyz + camDir * tTotal;
            g_PrimaryVirtualN = PortalToVirtual(path, nLight);
        }

        // Hybrid: sample with the vertex normal and re-shade the shadowed part with the detail normal (UltraRTLights.hlsl).
        if (hybridDetail) g_DetailN = n;
        float3 direct = DirectLighting(id, dim, pos, nLight, tTotal, layer, rng);
        if (hybridDetail)
        {
            // The composite scales the game's whole colour by shadowed / unshadowed, but the game's ambient doesn't
            // depend on the normal: apply the detail as (detail + ambient) / (vertex + ambient) on the vertex-normal
            // result, so grazing lights don't turn tilted texels black.
            const float3 lw = float3(0.2126, 0.7152, 0.0722);
            float a = dot(ToLight(_Ambient.rgb), lw) + 1e-3;
            direct = g_DirectVertex * ((dot(direct, lw) + a) / (dot(g_DirectVertex, lw) + a));
        }
        g_DetailN = 0;

        // One cosine-weighted diffuse bounce (pdf cancels the cosine and the 1/pi of Lambert).
        // Radiance cache (docs/radiance-cache.md): mode 2 reads the indirect light at the primary hit and skips the bounce
        // ray; mode 1 takes the lighting at the bounce hit from the cache (all further bounces, no shadow ray).
        float3 indirect = 0;
        bool cachedPrimary = false;
        if (_CacheMode == 2)
        {
            float u1 = Rand(rng), u2 = Rand(rng);
            cachedPrimary = CacheQueryIndirect(pos, nv, u1, u2, indirect);
        }
        if (!cachedPrimary)
        {
            RayDesc b;
            b.Origin = pos + nv * 0.02;
            b.Direction = CosineHemisphere(n, Rand(rng), Rand(rng));
            if (dot(b.Direction, nv) < 1e-3) b.Direction = reflect(b.Direction, nv); // detail normal: stay above the surface
            b.TMin = 0.0;
            b.TMax = 1.0e4;
            RayPayload h;
            float travelled;
            TraceScene(RAY_FLAG_CULL_BACK_FACING_TRIANGLES, ULTRART_MASK_SCENE, b, h, travelled); // b: the last segment after portals
            if (h.t < 0.0)
            {
                indirect = SkyLightRadiance(b.Direction) * SkyMissWeight(n, b.Direction); // MIS with SkyDirect below
            }
            else
            {
                float3 hp = b.Origin + b.Direction * h.t;
                float3 cached;
                float3 hitLight = (CacheQueryTotal(hp, h.normal, cached) ? cached : DirectOne(hp, h.normal, PayloadLayer(h), rng))
                                + ToLight(_Ambient.rgb) * _BounceAmbient * RelightAmbientScale();
                // Emitters that are sampled directly (EmissiveLights) must not also count when a bounce hits them.
                indirect = ToLight(PayloadEmission(h) * (_EmissionScale * _EmissiveBounceWeight)) + ToLight(h.albedo) * lerp(1.0, hitLight, h.alpha);
            }
        }
        // Sky light sampled directly (relight; one visibility ray). Counted with the indirect light: it is what the
        // bounce ray's sky misses estimate too, and the cache's indirect term (primary mode) leaves it out.
        indirect += SkyDirect(pos, n, rng);

        float3 ambient = ToLight(_Ambient.rgb) * _PrimaryAmbient * RelightAmbientScale();
        switch (_Mode)
        {
            default:
            case 0: lighting = direct + indirect + ambient; break;
            case 1: lighting = direct + ambient; break;
            case 2: lighting = indirect; break;
            // Hybrid: shadows come from _DirectLight/_GameLighting as a ratio; the denoised bounce is added on top.
            // Hybrid: only the bounce goes through the denoiser, plus emissive direct light as an optional extra (the game
            // doesn't light surfaces from emissives). The composite multiplies this channel by _GIStrength, hence the divide.
            // Virtual effect lights (EffectLights.cs) are added the same way, with their own weight.
            case 3: lighting = indirect + (g_DirectEmissive * _EmissiveHybridAdd + g_DirectAdditive) / max(_GIStrength, 1e-3); break;
        }
        lighting = lerp(1.0, lighting, p.alpha); // fullbright surfaces ignore lighting, like the game
        albedo = p.albedo;
        emission = PayloadEmission(p) * _EmissionScale;
        float3 shown = LightToDisplay(lighting); // = lighting unless linear transport (_Radiance keeps lighting space)
        c = albedo * shown + emission;

        // One reflection ray where the specular term is worth it (the same weights the composites use).
        SurfaceMaterial mat = MaterialFromPayload(p.material, p.flags);
        float4 refl = float4(0, 0, 0, -1);
        if (_ReflParams.x > 0.5 && mat.mode != ULTRART_REFL_NONE && _Mode != 2)
        {
            float NdotV = saturate(dot(n, -ray.Direction));
            float3 specW;
            float keep;
            SpecularTerms(mat, albedo, NdotV, _ReflParams.yz, _Mode == 3, specW, keep);
            if (dot(specW, float3(0.2126, 0.7152, 0.0722)) >= _ReflParams.w)
            {
                float3 L = ReflectionDirection(n, ray.Direction, mat.roughness, rng);
                if (dot(L, nv) < 1e-3) L = reflect(ray.Direction, nv); // detail normal tilted the lobe below the surface
                float dist;
                // One trace pixel's angle, for the cache footprint test (from the neighbouring pixel's ray).
                float4 farN = mul(_InvViewProj, float4(ndc + float2(2.0 / (float)dim.x, 0.0), 1.0, 1.0));
                float pixelAngle = length(normalize(farN.xyz / farN.w - _CamPos.xyz) - camDir);
                float3 lr = TraceReflection(pos, nv, L, mat.roughness >= 0.03, 2.0 * mat.roughness * mat.roughness, pixelAngle, tTotal, rng, dist);
                refl = float4(lr, dist);
                // Non-denoised output (pt, pt-direct, accumulation): apply it here. Denoised modes resolve the filtered
                // reflection in Reflections.compute instead.
                if (_Mode <= 1) c = albedo * shown * keep + emission + specW * lr;
            }
        }
        _Reflection[id] = refl;
        // Game cubemap (hybrid): replaced only where we apply a reflection of our own; elsewhere the game's stays.
        uint4 surface = PackSurface(albedo, emission, p.material, p.flags);
        float3 gameCube = 0;
        if (wantGameCube && (p.flags & ULTRART_FLAG_GAMECUBE) != 0u && mat.mode != ULTRART_REFL_NONE)
        {
            gameCube = float3(FromUnorm8(p.uvHalf), FromUnorm8(p.uvHalf >> 8), FromUnorm8(p.uvHalf >> 16));
            float lightContribution = FromUnorm8(p.primitive >> 24);
            if (lightContribution > 0.0) // the game tints it by its vertex lighting (2 * ambient + unshadowed lights)
                gameCube *= lerp(1.0, UnshadowedAll(pos, nv, layer) + _Ambient.rgb, lightContribution);
            surface = SurfaceSetGameCube(surface, FromUnorm8(p.uvHalf >> 24));
        }
        _Surface[id] = surface;
        _NormalDepth[id] = float4(PortalToVirtual(path, n), tTotal);
        float3 un = g_DirectUnshadowed; // same samples as `direct`, without visibility
        _HybridLight[id] = uint4(f32tof16(un.r) | (f32tof16(un.g) << 16),
                                 f32tof16(un.b) | (f32tof16(direct.r) << 16),
                                 f32tof16(direct.g) | (f32tof16(direct.b) << 16),
                                 PackHybridW(p.alpha, gameCube));
        // x: instance (consumers use its low 7 bits). Seen through a portal, the high half holds the distance to the first
        // portal surface (half float, > 0), which is what the game's depth buffer has there (Composite.shader).
        uint instWord = p.instance & 0xFFFFu;
        if (path.hops > 0u) instWord |= min(f32tof16(max(path.firstT, 1e-3)), 0x7BFFu) << 16;
        _InstanceId[id] = int2((int)instWord, (int)motion);
    }

    _Radiance[id] = float4(lighting, 1.0);

    if (_AccumFrames > 0)
    {
        float4 prev = _Output[id];
        c = lerp(prev.rgb, c, 1.0 / (float)(_AccumFrames + 1));
    }

    // Water and glass: along the camera ray, up to the opaque hit or the first portal (the game doesn't overlay what it
    // shows through a portal).
    _Output[id] = _TransParams.y > 0.5 ? TraceTransparent(camRay, path.hops > 0u ? path.firstT : p.t, rng) : float4(c, 1.0);
}

[shader("miss")]
void Miss(inout RayPayload p : SV_RayPayload)
{
    p.t = -1.0;
}
