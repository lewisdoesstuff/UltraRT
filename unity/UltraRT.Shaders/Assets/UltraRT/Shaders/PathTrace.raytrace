// Lighting pass: primary hit, shadowed direct light using ULTRAKILL's own light model, and one diffuse
// bounce that picks up emissive surfaces plus one shadowed light sample at the bounce.
// Writes a composited image plus demodulated G-buffer channels for the denoiser.
// Glossy and REFLECTION surfaces also trace one reflection ray (docs/reflections.md).
#pragma max_recursion_depth 1

#include "UltraRTCommon.hlsl"
#include "UltraRTMaterial.hlsl"

RaytracingAccelerationStructure _Scene;
#include "UltraRTPortals.hlsl" // TraceScene: rays follow portals (docs/portals.md)
// NOTE: Unity ray tracing shaders support at most 8 UAVs; a 9th makes DispatchRays fail silently. This shader binds
// the 7 below (one slot is free since ReSTIR's _ReservoirCur went, 2026-11-19). Albedo and emission share _Surface.
RWTexture2D<float4> _Output;      // composited (albedo * lighting + emission + reflections); also the accumulation history (ARGBHalf)
RWTexture2D<float4> _Radiance;    // demodulated lighting (not multiplied by albedo); a = 2: moving-occluder flag, else 1
RWTexture2D<uint4>  _Surface;     // packed albedo, emission and reflection material (UltraRTMaterial.hlsl, PackSurface)
RWTexture2D<float4> _NormalDepth; // xyz world normal, w = hit distance (< 0 = sky)
RWTexture2D<int2>   _InstanceId;  // RGInt: x InstanceIndex() (-1 = sky), y packed world-space motion (PackMotion, 0 = static)
RWTexture2D<uint4>  _LitWeight;   // w & 0xFF: lit weight unorm8 (0 = fullbright), for auto exposure and DLSS RR; xyz unused
RWTexture2D<float4> _Reflection;  // rgb reflected radiance; a: reflection hit distance (sky: 1000), -1 = not traced

float4x4 _InvViewProj;
float4   _CamPos;
int      _Mode;          // 0 full, 1 direct only, 2 indirect only
uint     _FrameIndex;
uint     _AccumFrames;   // frames already accumulated (0 = reset)

// Light buffers (_Lights, _LightMasks, _LightCount) and light sampling state: UltraRTLights.hlsl.

// Sky (_SkyColor, _SkyTex, SkyRadiance, sky light sampling): UltraRTSky.hlsl.
float4   _Ambient;        // the game's ambient term (2 * RenderSettings.ambientLight)
float    _PrimaryAmbient; // how much of _Ambient to add at the primary hit (art knob)
float    _BounceAmbient;  // how much of _Ambient to add at the bounce hit (stand-in for further bounces)
float    _LightScale;
float    _EmissionScale;
// Reflections: x enabled, y global specular weight, z global reflection strength, w minimum weight (luminance of the
// specular term) worth a ray. Pixels below it skip the ray, so the cost follows glossy coverage.
float4   _ReflParams;
float    _ReflMaxRadiance; // firefly clamp (luminance) for glossy reflections; mirrors are not clamped
// Reflections v2 (docs/reflections.md): x radiance cache at reflection hits (0 off, 1 by footprint, 2 always),
// y footprint threshold (fraction of a cache cell). Unbound = all off.
float4   _ReflCache;
// World-space motion of the primary hit (previous position - current), from its packed motion; through portals in the
// camera-side space (RayGenBody).
static float3 g_PrimaryMotion = 0;

// ---------------------------------------------------------------- rng

uint Pcg(inout uint s)
{
    s = s * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
    return (w >> 22u) ^ w;
}

float Rand(inout uint s) { return Pcg(s) * (1.0 / 4294967296.0); }

float3 CosineHemisphere(float3 n, float u1, float u2)
{
    float r = sqrt(u1);
    float phi = 6.28318530718 * u2;
    float3 t = abs(n.y) < 0.999 ? normalize(cross(n, float3(0, 1, 0))) : float3(1, 0, 0);
    float3 b = cross(n, t);
    return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - u1)));
}

// GGX distribution of visible normals (Heitz 2018), tangent space with z = normal. Ve: view direction (towards the eye).
float3 SampleGgxVndf(float3 Ve, float alpha, float u1, float u2)
{
    float3 Vh = normalize(float3(alpha * Ve.x, alpha * Ve.y, Ve.z));
    float lensq = Vh.x * Vh.x + Vh.y * Vh.y;
    float3 T1 = lensq > 0.0 ? float3(-Vh.y, Vh.x, 0.0) * rsqrt(lensq) : float3(1.0, 0.0, 0.0);
    float3 T2 = cross(Vh, T1);
    float r = sqrt(u1);
    float phi = 6.28318530718 * u2;
    float t1 = r * cos(phi);
    float t2 = r * sin(phi);
    float s = 0.5 * (1.0 + Vh.z);
    t2 = (1.0 - s) * sqrt(max(0.0, 1.0 - t1 * t1)) + s * t2;
    float3 Nh = t1 * T1 + t2 * T2 + sqrt(max(0.0, 1.0 - t1 * t1 - t2 * t2)) * Vh;
    return normalize(float3(alpha * Nh.x, alpha * Nh.y, max(1e-6, Nh.z)));
}

// Reflection direction for roughness r: the exact mirror direction below 0.03, else a GGX (alpha = r^2) VNDF sample.
// The estimator is the plain radiance along that direction: the Fresnel term is applied by the composite, and the
// G2/G1 factor of VNDF sampling is taken as 1. Samples that end up below the surface fall back to the mirror direction.
float3 ReflectionDirection(float3 n, float3 dir, float roughness, inout uint rng)
{
    float3 mirror = reflect(dir, n);
    if (roughness < 0.03) return mirror;
    float3 t = abs(n.y) < 0.999 ? normalize(cross(n, float3(0, 1, 0))) : float3(1, 0, 0);
    float3 b = cross(n, t);
    float3 V = -dir;
    float3 Ve = float3(dot(V, t), dot(V, b), max(dot(V, n), 1e-4));
    float3 h = SampleGgxVndf(Ve, max(roughness * roughness, 1e-3), Rand(rng), Rand(rng));
    float3 H = normalize(t * h.x + b * h.y + n * h.z);
    float3 L = reflect(dir, H);
    return dot(L, n) > 1e-3 ? L : mirror;
}

// ---------------------------------------------------------------- lights

#define ULTRART_MOVERS // moving-occluder boxes: _Radiance.a flags the pixel for the denoiser (UltraRTLights.hlsl)
#include "UltraRTLights.hlsl"
#include "UltraRTCache.hlsl" // radiance cache lookups (read-only: no UAVs)
#include "UltraRTSky.hlsl"   // sky radiance and sky light sampling (SRVs only)
#include "UltraRTEffects.hlsl" // glowing effects along a specular ray (EffectsAlong)
#include "UltraRTStains.hlsl"  // blood stains at reflection hits (StainTint)

// ---------------------------------------------------------------- reflections

// Lighting arriving at a reflection hit. With the radiance cache, a hit whose reflection footprint (lobe spread plus
// the pixel's footprint at the virtual image distance) covers at least _ReflCache.y of a cache cell reads the cell's
// total lighting: no shadow ray, no light-selection speckle, and multi-bounce light. Smaller footprints (mirrors, sharp
// glossy) keep the 1-sample direct light, for sharp shadows in the reflection, plus the cell's indirect light. A missing
// or unconverged cell falls back to the old estimate (direct + ambient only).
float3 ReflectionHitLight(float3 hp, RayPayload h, float footprint, inout uint rng)
{
    float3 total = 0, indirect = 0;
    bool cached = false;
    if (_ReflCache.x > 0.5) cached = CacheLookup(hp, h.normal, total, indirect); // not &&: HLSL 2018 doesn't short-circuit
    float3 light;
    if (cached && (_ReflCache.x > 1.5 || footprint >= CacheCellSize(CacheLevel(hp)) * _ReflCache.y))
        light = total;
    else
        light = DirectOne(hp, h.normal, PayloadLayer(h), rng) + (cached ? indirect : 0.0);
    return light + ToLight(_Ambient.rgb) * _BounceAmbient * RelightAmbientScale();
}

// Radiance arriving along one reflection ray: the hit's albedo x lighting (ReflectionHitLight) + its emission (in
// full: emissive light sampling only covers the diffuse lobe), or the sky. In display (gamma) units: with linear
// transport the hit's lighting is converted per sample. Sky walls report a miss, so they reflect as
// sky too. dist: hit distance, or 1000 for the sky (the virtual image point). spread: lobe spread (radians, roughly
// alpha); pixelAngle: one trace pixel's angle; t: primary hit distance (for the footprint).
float3 TraceReflection(float3 pos, float3 n, float3 L, bool glossy, float spread, float pixelAngle, float t, inout uint rng, out float dist)
{
    // Ray cone for the hit's texture LOD (docs/materials.md, "Texture LOD"): the camera pixel's cone, widened by the
    // glossy lobe; the same footprint as the cache test below.
    float2 cone = float2(t * pixelAngle, pixelAngle + (glossy ? spread : 0.0));
    RayDesc r;
    r.Origin = pos + n * 0.02;
    r.Direction = L;
    r.TMin = 0.0;
    r.TMax = 1.0e4;
    RayPayload h;
    float travelled;
    // V1's third-person model shows in reflections (camera rays never see it). No per-texel detail at reflection hits
    // (docs/materials.md): measured +0.2 ms in metal rooms, invisible after the filter.
    ULTRART_SET_RAY_KIND(ULTRART_RAY_REFLECTION);
    TraceSceneCone(RAY_FLAG_CULL_BACK_FACING_TRIANGLES, ULTRART_MASK_SCENE | PlayerRayMask(ULTRART_PLAYER_REFLECTION), cone, r, h, travelled); // r: the last segment after portals
    float3 c;
    if (h.t < 0.0)
    {
        dist = 1000.0;
        c = SkyRadiance(r.Direction);
    }
    else
    {
        float ht = travelled + h.t;
        dist = ht;
        float3 hp = r.Origin + r.Direction * h.t;
        float footprint = ht * spread + (t + ht) * pixelAngle;
        float3 hitLight = ReflectionHitLight(hp, h, footprint, rng);
        c = PayloadEmission(h) * _EmissionScale + h.albedo * StainTint(hp, h.normal) * lerp(1.0, LightToDisplay(hitLight), h.alpha);
    }
    // Fire, explosions, flashes and beams in front of the hit (the last segment after portals), added as the game blends them.
    c += EffectsAlong(r.Origin, r.Direction, h.t < 0.0 ? 1.0e4 : h.t) * (glossy ? EffectLobeWeight(sqrt(0.5 * spread)) : 1.0);
    c = max(c, 0.0); // also drops NaN
    if (glossy)
    {
        float l = dot(c, float3(0.2126, 0.7152, 0.0722));
        if (l > _ReflMaxRadiance) c *= _ReflMaxRadiance / l;
    }
    return c;
}

// ---------------------------------------------------------------- water and glass (docs/reflections.md, "Water and glass")

// Transparent surfaces (instance mask 0x10) are invisible to every other ray. In denoised modes
// (_TransParams.y = 1, only while a water/glass instance is active) the end of RayGen finds the nearest water or glass
// surface in front of the opaque hit and traces its mirror reflection (procedural ripples on water), writing
// _Output = (reflected radiance, distance to the transparent surface; < 0 = none) instead of the composited colour,
// which those modes never read. No ninth UAV and no second DispatchRays (a second dispatch rebuilds the shader table:
// measured +0.2-0.3 ms of frame time). TransparentOverlay.shader applies it with Fresnel right after the game draws
// the surface, so particles in front still cover it.
#include "UltraRTWater.hlsl"

// x: lobe spread used for the reflection hit's cache footprint test (large = always shade from the radiance cache:
// smooth, no shadow-ray noise; there is no temporal filter on this pass). y: 1 = trace transparents into _Output.
float4 _TransParams;
float4 _TransRect; // NDC rectangle that holds every water / glass / blood instance (Plugin.Transparent.cs); outside: no transparent ray

float4 TraceTransparent(RayDesc ray, float opaqueT, float pixelAngle, inout uint rng)
{
    ray.TMin = 0.0;
    ray.TMax = opaqueT > 0.0 ? opaqueT + 0.05 : 1.0e5;
    RayPayload p = (RayPayload)0;
    p.t = -1.0;
    p.flags = ULTRART_PAYLOAD_TRANSPARENT; // transparent instances with the geometry bit (stained glass) answer only this ray
    ULTRART_COUNT_RAY(ULTRART_RAY_TRANSPARENT);
    TraceRay(_Scene, RAY_FLAG_CULL_BACK_FACING_TRIANGLES, ULTRART_MASK_TRANSPARENT, 0, 1, 0, ray, p);
    if (p.t < 0.0) return float4(0, 0, 0, -1);

    float3 pos = ray.Origin + ray.Direction * p.t;
    float3 ng = p.normal; // faces the ray
    SurfaceMaterial mat = MaterialFromPayload(p.material, p.flags);
    float3 n = ng;
    // 13 = Wet: water. One texel of this trace covers p.t x pixelAngle across the view and 1 / cos more along it.
    if (mat.cls == 13u)
        n = WaterNormalBand(ng, pos, p.t, _UltraRTWaterBand > 0.5 ? p.t * pixelAngle / max(abs(dot(ng, ray.Direction)), 0.05) : 0.0);
    float3 L = reflect(ray.Direction, n);
    if (dot(L, ng) < 0.02) L = reflect(ray.Direction, ng);
    float dist;
    float3 lr = TraceReflection(pos, ng, L, false, _TransParams.x, 0.0, p.t, rng, dist);
    return float4(lr, p.t);
}

// Texture LOD (docs/materials.md, "Texture LOD"; Plugin.Materials.cs): _UltraRTTexLod2.y = the spread angle a diffuse
// bounce adds to the ray cone (its sample stands for a wide lobe: the hit's albedo is averaged accordingly).
float4 _UltraRTTexLod2;
float2 DiffuseCone(float2 cone) { return float2(cone.x, cone.y + _UltraRTTexLod2.y); }
float2 GlossyCone(float2 cone, float roughness) { return float2(cone.x, cone.y + 2.0 * roughness * roughness); }

#include "UltraRTPathTraceFull.hlsl" // the pathtrace mode's paths: PtIndirect, PtReflection (docs/path-tracing.md)

// ---------------------------------------------------------------- ray generation

// full: the pathtrace mode (RayGenPT). A compile-time constant at both call sites, so RayGen (relight and every other
// mode) compiles to exactly what it was.
// Wet blood (docs/vfx.md): the wetness of the fresh blood stains under each screen pixel (BloodWet.shader), read at the
// primary hit. x: strength (0 = off, the texture is a dummy), yz: traced size / visible size (guard band), w: darkening.
Texture2D<float> _BloodWetTex;
SamplerState my_linear_clamp_sampler;
float4 _BloodWetParams;
float4 _BloodWetGloss; // x roughness, y f0, z specular weight of fully wet blood

void RayGenBody(bool full)
{
    uint2 id = DispatchRaysIndex().xy;
    uint2 dim = DispatchRaysDimensions().xy;
    uint rng = (id.x * 1973u + id.y * 9277u + _FrameIndex * 26699u) | 1u;
    float g_PlayerF = 1.0; // player shadow factor (see _Radiance below)
    g_ShadowRng = HashU32(rng);
    g_ShadowPlayerMask = PlayerRayMask(ULTRART_PLAYER_SHADOW); // V1 casts shadows (docs/reflections.md, "The player in reflections")

    // Jitter within the pixel only while accumulating, so a single frame stays stable.
    float2 jitter = _AccumFrames > 0 ? float2(Rand(rng), Rand(rng)) : float2(0.5, 0.5);
    float2 ndc = ((float2)id + jitter) / (float2)dim * 2.0 - 1.0;
    float4 farPt = mul(_InvViewProj, float4(ndc, 1.0, 1.0));
    farPt.xyz /= farPt.w;

    RayDesc ray;
    ray.Origin = _CamPos.xyz;
    ray.Direction = normalize(farPt.xyz - _CamPos.xyz);
    ray.TMin = 0.0;
    ray.TMax = 1.0e5;

    RayPayload p;
    // One trace pixel's angle (from the neighbouring pixel's ray): the camera ray's cone for the hit's texture LOD
    // (docs/materials.md, "Texture LOD"), and the reflection's cache footprint test.
    float4 farN = mul(_InvViewProj, float4(ndc + float2(2.0 / (float)dim.x, 0.0), 1.0, 1.0));
    float pixelAngle = length(normalize(farN.xyz / farN.w - _CamPos.xyz) - ray.Direction);
    g_Cone = float2(0.0, pixelAngle);
    // The hit returns its motion in p.motion; per-texel detail at the cone's mip.
    uint inFlags = ULTRART_PAYLOAD_WANT_MOTION | ULTRART_FLAG_DETAIL | ULTRART_PAYLOAD_CONE;
    // Portal mirrors: keep the game's own mirror view (it shows V1 and is sharper than a traced reflection). The ray stops
    // there and the pixel is written like sky, which every composite leaves to the game (docs/portals.md, "Mirrors").
    if (_UltraRTMirrors == 0) inFlags |= ULTRART_TRACE_STOP_AT_MIRROR;
    // Through portals the ray continues on the far side (UltraRTPortals.hlsl): from here on `ray` is the last segment, so
    // shading uses the real hit point and direction. The G-buffer gets the camera-side ("virtual") view of the hit: path
    // length, normal and motion as seen through the portals, so the denoiser and the reflection filter reproject
    // it like any other surface (portals are rigid).
    float3 camDir = ray.Direction;
    RayDesc camRay = ray;
    PortalPath path;
    ULTRART_SET_RAY_KIND(ULTRART_RAY_CAMERA);
    TraceScene(RAY_FLAG_CULL_BACK_FACING_TRIANGLES, ULTRART_MASK_SCENE | PlayerRayMask(ULTRART_PLAYER_CAMERA), inFlags, ray, p, path);

    float3 c, lighting, albedo, emission;
    if (p.t < 0.0)
    {
        c = SkyRadiance(ray.Direction);
        lighting = ToLight(c); // lighting space; the composites convert back
        albedo = 1;
        emission = 0;
        _NormalDepth[id] = float4(0, 0, 0, -1);
        _LitWeight[id] = uint4(0, 0, 0, 0);
        _InstanceId[id] = int2(-1, 0);
        _Surface[id] = PackSurface(albedo, emission, 0u, 0u);
        _Reflection[id] = float4(0, 0, 0, -1);
    }
    else
    {
        float3 pos = ray.Origin + ray.Direction * p.t;
        float3 n = p.normal; // shading normal: per-texel detail where the material has it (docs/materials.md)
        EffectCover(camRay.Origin, camRay.Direction, path.firstT >= 0.0 ? path.firstT : p.t); // UltraRTEffects.hlsl
        // The interpolated vertex normal: ray offsets and the hemisphere test, the radiance cache lookup.
        bool detail = (p.flags & ULTRART_FLAG_DETAIL) != 0u;
        float3 nv = detail ? UnpackOct24(p.primitive) : n;
        if (dot(nv, ray.Direction) > 0.0) nv = -nv; // faces the ray, like p.normal
        uint layer = PayloadLayer(p);
        uint motion = p.motion;
        float tTotal = path.travelled + p.t;
        g_PrimaryMotion = UnpackMotion(motion);
        if (path.hops > 0u)
        {
            float3 virtualPos = _CamPos.xyz + camDir * tTotal;
            if (path.moved)
            {
                // A portal on the path moved: the camera-side image of the hit moved with it. Where the camera saw this
                // point last frame = last frame's path transform, inverted, of the point then (hit + its own motion).
                float3 hitPrev = ray.Origin + ray.Direction * p.t + g_PrimaryMotion;
                g_PrimaryMotion = mul(hitPrev - path.prevOff, path.prevRot) - virtualPos;
                // That place was not behind the opening then: the view slid, and this point came out from behind the
                // opening's edge. Its history is the wall beside the portal, so send the lookup off screen (DLSS RR
                // and the denoiser then start it fresh). 8-3's hallway left thin lines of the wall's colour on the
                // sliding view otherwise (user, 2026-11-18).
                if (_UltraRTPortalEdge != 0 && !PortalSegmentThrough(path.first, _CamPos.xyz, virtualPos + g_PrimaryMotion))
                {
                    float3 side = cross(camDir, abs(camDir.y) < 0.9 ? float3(0, 1, 0) : float3(1, 0, 0));
                    g_PrimaryMotion = normalize(side) * 2e4;
                }
            }
            else g_PrimaryMotion = PortalToVirtual(path, g_PrimaryMotion);
            motion = PackMotion(g_PrimaryMotion);
        }

        float3 direct = DirectLighting(pos, n, layer, rng);
        if (full) PtMoreDirect(direct, pos, n, layer, rng); // pathtrace: more light samples per pixel (RIS)

        // One cosine-weighted diffuse bounce (pdf cancels the cosine and the 1/pi of Lambert).
        // Radiance cache (docs/radiance-cache.md): mode 2 reads the indirect light at the primary hit and skips the bounce
        // ray; mode 1 takes the lighting at the bounce hit from the cache (all further bounces, no shadow ray).
        float3 indirect = 0;
        bool cachedPrimary = false;
        // Ray cone at the primary hit (texture LOD at secondary hits): this pixel's footprint there, and its angle.
        float2 hitCone = float2(tTotal * pixelAngle, pixelAngle);
        if (full)
        {
            // Path tracing: N multi-bounce paths with next-event estimation at every vertex (UltraRTPathTraceFull.hlsl).
            indirect = PtIndirect(pos, n, nv, hitCone, rng);
            cachedPrimary = true;
        }
        else if (_CacheMode == 2)
        {
            float u1 = Rand(rng), u2 = Rand(rng);
            cachedPrimary = CacheQueryIndirect(pos, nv, u1, u2, indirect);
        }
        if (!cachedPrimary)
        {
            RayDesc b;
            b.Origin = pos + nv * 0.02;
            b.Direction = CosineHemisphere(n, Rand(rng), Rand(rng));
            if (dot(b.Direction, nv) < 1e-3) b.Direction = reflect(b.Direction, nv); // detail normal: stay above the surface
            b.TMin = 0.0;
            b.TMax = 1.0e4;
            RayPayload h;
            float travelled;
            ULTRART_SET_RAY_KIND(ULTRART_RAY_BOUNCE);
            TraceSceneCone(RAY_FLAG_CULL_BACK_FACING_TRIANGLES, ULTRART_MASK_SCENE | PlayerRayMask(ULTRART_PLAYER_BOUNCE),
                           DiffuseCone(hitCone), b, h, travelled); // b: the last segment after portals
            if (h.t < 0.0)
            {
                indirect = SkyLightRadiance(b.Direction) * SkyMissWeight(n, b.Direction); // MIS with SkyDirect below
            }
            else
            {
                float3 hp = b.Origin + b.Direction * h.t;
                // An if, not ?: (HLSL 2018 evaluates both sides: DirectOne's candidates and shadow ray ran on every cache hit).
                float3 hitLight;
                [branch] if (!CacheQueryTotal(hp, h.normal, hitLight)) hitLight = DirectOne(hp, h.normal, PayloadLayer(h), rng);
                hitLight += ToLight(_Ambient.rgb) * _BounceAmbient * RelightAmbientScale();
                // Emitters that are sampled directly (EmissiveLights) must not also count when a bounce hits them.
                indirect = ToLight(PayloadEmission(h) * (_EmissionScale * _EmissiveBounceWeight)) + ToLight(h.albedo) * lerp(1.0, hitLight, h.alpha);
            }
        }
        // Sky light sampled directly (relight; one visibility ray). Counted with the indirect light: it is what the
        // bounce ray's sky misses estimate too, and the cache's indirect term (primary mode) leaves it out.
        indirect += SkyDirect(pos, n, rng);

        float3 ambient = ToLight(_Ambient.rgb) * _PrimaryAmbient * RelightAmbientScale();
        switch (_Mode)
        {
            default:
            case 0: lighting = direct + indirect + ambient; break;
            case 1: lighting = direct + ambient; break;
            case 2: lighting = indirect; break;
        }
        lighting = lerp(1.0, lighting, p.alpha); // fullbright surfaces ignore lighting, like the game
        if (any(g_PlayerBlocked > 0.0))
        {
            // The share of this pixel's lighting V1 blocks (the lighting above ignores V1 when the split is on).
            const float3 lw = float3(0.2126, 0.7152, 0.0722);
            g_PlayerF = saturate(1.0 - p.alpha * dot(g_PlayerBlocked, lw) / max(dot(lighting, lw), 1e-6));
        }
        albedo = p.albedo;
        if (_BloodWetParams.x > 0.0 && path.hops == 0u && p.alpha > 0.5)
        {
            // Fresh blood on this pixel: a glossy, darker film over the surface (a dielectric coat, as rain; REFLECTION
            // materials keep the game's model). The game multiplies the stain's red over the result afterwards.
            float2 suv = ndc * _BloodWetParams.yz * 0.5 + 0.5;
            float bw = all(suv > 0.0) && all(suv < 1.0) ? _BloodWetTex.SampleLevel(my_linear_clamp_sampler, suv, 0) * _BloodWetParams.x : 0.0;
            if (bw > 0.0)
            {
                SurfaceMaterial bm = MaterialFromPayload(p.material, p.flags);
                albedo *= 1.0 - _BloodWetParams.w * bw;
                if (bm.mode != ULTRART_REFL_BLEND && bm.mode != ULTRART_REFL_ADD)
                {
                    if (bm.mode == ULTRART_REFL_NONE) { bm.roughness = 1.0; bm.weight = 0.0; bm.metalness = 0.0; bm.f0 = 0.0; }
                    float nonMetal = 1.0 - bm.metalness;
                    bm.roughness = lerp(bm.roughness, min(bm.roughness, _BloodWetGloss.x), bw);
                    bm.f0 = max(bm.f0, _BloodWetGloss.y * bw);
                    bm.weight = max(bm.weight, _BloodWetGloss.z * bw * nonMetal);
                    p.material = PackMaterialWord(bm.roughness, bm.metalness, bm.f0, bm.weight);
                    p.flags = (p.flags & ~(3u << 1)) | (ULTRART_REFL_SPECULAR << 1);
                }
            }
        }
        emission = PayloadEmission(p) * _EmissionScale;
        if (_StainParams.x > 1.5) { float sw; if (StainAt(pos, n, sw) > 0.0) emission += float3(0.0, 2.0, 0.0); } // debug: the lookup at camera hits (green), to line up with the game's decals
        float3 shown = LightToDisplay(lighting); // = lighting unless linear transport (_Radiance keeps lighting space)
        c = albedo * shown + emission;

        // One reflection ray where the specular term is worth it (the same weights the composites use).
        SurfaceMaterial mat = MaterialFromPayload(p.material, p.flags);
        float4 refl = float4(0, 0, 0, -1);
        if (_ReflParams.x > 0.5 && mat.mode != ULTRART_REFL_NONE && _Mode != 2)
        {
            float NdotV = saturate(dot(n, -ray.Direction));
            float3 specW;
            float keep;
            SpecularTerms(mat, albedo, NdotV, _ReflParams.yz, specW, keep);
            if (dot(specW, float3(0.2126, 0.7152, 0.0722)) >= _ReflParams.w)
            {
                float3 L = ReflectionDirection(n, ray.Direction, mat.roughness, rng);
                if (dot(L, nv) < 1e-3) L = reflect(ray.Direction, nv); // detail normal tilted the lobe below the surface
                float dist;
                float3 lr;
                if (full) lr = PtReflection(pos, nv, n, ray.Direction, mat.roughness, hitCone, rng, dist); // specular paths
                else lr = TraceReflection(pos, nv, L, mat.roughness >= 0.03, 2.0 * mat.roughness * mat.roughness, pixelAngle, tTotal, rng, dist);
                refl = float4(lr, dist);
                // Non-denoised output (pt, pt-direct, accumulation): apply it here. Denoised modes resolve the filtered
                // reflection in Reflections.compute instead.
                if (_Mode <= 1) c = albedo * shown * keep + emission + specW * lr;
            }
        }
        _Reflection[id] = refl;
        _Surface[id] = PackSurface(albedo, emission, p.material, p.flags);
        _NormalDepth[id] = float4(PortalToVirtual(path, n), tTotal);
        _LitWeight[id] = uint4(0, 0, 0, Unorm8(p.alpha));
        // x: instance (consumers use its low 7 bits). Seen through a portal, the high half holds the distance to the first
        // portal surface (half float, > 0), which is what the game's depth buffer has there (Composite.shader).
        uint instWord = p.instance & 0xFFFFu;
        if (path.hops > 0u) instWord |= min(f32tof16(max(path.firstT, 1e-3)), 0x7BFFu) << 16;
        _InstanceId[id] = int2((int)instWord, (int)motion);
    }

    // a: 1, or 2 where the direct light sample crossed a moving occluder (the denoiser's targeted anti-lag; docs/denoiser.md
    // "Moving shadows").
    // a: the player shadow factor (1 - the share of this pixel's lighting V1 blocks; 1 = none), + 2 where the light
    // sample crossed a moving occluder (docs/denoiser.md, "Moving shadows"). Only relight/pt-dn split V1's shadow off.
    _Radiance[id] = float4(lighting, g_PlayerF + (g_MoverShadow ? 2.0 : 0.0));

    if (_AccumFrames > 0)
    {
        float4 prev = _Output[id];
        c = lerp(prev.rgb, c, 1.0 / (float)(_AccumFrames + 1));
    }

    // Water and glass: along the camera ray, up to the opaque hit or the first portal (the game doesn't overlay what it
    // shows through a portal).
    // An if, not ?: (HLSL 2018 evaluates both sides: the transparent ray and its reflection were traced in every mode).
    float4 outC = float4(c, 1.0);
    [branch] if (_TransParams.y > 0.5 && all(ndc >= _TransRect.xy) && all(ndc <= _TransRect.zw))
        outC = TraceTransparent(camRay, path.firstT >= 0.0 ? path.firstT : p.t, pixelAngle, rng);
    _Output[id] = outC;
}

#ifdef ULTRART_RAY_COUNTS
// PathTraceCount.raytrace (docs/performance.md, "Ray counts"): the same ray generation, then this pixel's ray counts by
// kind over its outputs (0-3 in _Output, 4-7 in _Radiance; the plugin reads them back). The image is not usable.
void RayCountsBegin()
{
    [unroll] for (uint k = 0u; k < 8u; k++) g_RayCount[k] = 0u;
    g_RayKind = ULTRART_RAY_CAMERA;
}
void RayCountsWrite()
{
    uint2 id = DispatchRaysIndex().xy;
    _Output[id] = float4(g_RayCount[0], g_RayCount[1], g_RayCount[2], g_RayCount[3]);
    _Radiance[id] = float4(g_RayCount[4], g_RayCount[5], g_RayCount[6], g_RayCount[7]);
}
[shader("raygeneration")]
void RayGen() { RayCountsBegin(); RayGenBody(false); RayCountsWrite(); }
[shader("raygeneration")]
void RayGenPT() { RayCountsBegin(); RayGenBody(true); RayCountsWrite(); }
#else
[shader("raygeneration")]
void RayGen() { RayGenBody(false); }

// The pathtrace mode (docs/path-tracing.md). Same bindings, same outputs.
[shader("raygeneration")]
void RayGenPT() { RayGenBody(true); }
#endif

[shader("miss")]
void Miss(inout RayPayload p : SV_RayPayload)
{
    p.t = -1.0;
}
