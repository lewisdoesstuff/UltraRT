// Primary-ray debug view: shoots one ray per pixel from the game camera and visualises what it hits.
#pragma max_recursion_depth 1

#include "UltraRTCommon.hlsl"
#include "UltraRTMaterial.hlsl"

RaytracingAccelerationStructure _Scene;
#include "UltraRTPortals.hlsl" // TraceScene: rays follow portals (docs/portals.md)
RWTexture2D<float4> _Output;

float4x4 _InvViewProj;   // inverse(projection * view), OpenGL-style clip space
float4   _CamPos;
int      _Mode;          // 0 lit albedo, 1 albedo, 2 normals, 3 depth, 4 instance, 5 uv, 6 emission, 7 primitive,
                         // 8 material class, 9 reflection parameters
float    _DepthScale;

[shader("raygeneration")]
void RayGen()
{
    uint2 id = DispatchRaysIndex().xy;
    uint2 dim = DispatchRaysDimensions().xy;

    float2 ndc = ((float2)id + 0.5) / (float2)dim * 2.0 - 1.0;

    RayDesc ray;
    ray.Origin = _CamPos.xyz;
    ray.Direction = UltraRTCameraRay(_InvViewProj, ndc, _CamPos.xyz);
    ray.TMin = 0.0;
    ray.TMax = 1.0e5;

    RayPayload p;
    PortalPath path;
    TraceScene(RAY_FLAG_CULL_BACK_FACING_TRIANGLES, ULTRART_MASK_SCENE, 0u, ray, p, path);
    if (p.t >= 0.0) p.t += path.travelled; // depth view: the distance along the bent path

    float3 c;
    if (p.t < 0.0)
    {
        // Miss: dark magenta gradient so holes in the scene stand out.
        c = lerp(float3(0.05, 0.0, 0.08), float3(0.25, 0.0, 0.3), saturate(ray.Direction.y * 0.5 + 0.5));
    }
    else
    {
        switch (_Mode)
        {
            default:
            case 0: c = p.albedo * (0.25 + 0.75 * saturate(dot(p.normal, -ray.Direction))) + PayloadEmission(p); break;
            case 1: c = p.albedo; break;
            case 2: c = p.normal * 0.5 + 0.5; if (p.flags & 1) c *= float3(1, 0.4, 0.4); break;
            case 3: c = (float3)saturate(1.0 - p.t / _DepthScale); break;
            case 4: c = HashColor(p.instance + 1); break;
            case 5: c = float3(frac(PayloadUV(p)), 0); break;
            case 6: c = PayloadEmission(p); break;
            case 7: c = HashColor(p.primitive * 7919u + p.instance); break;
            case 8:
            {
                // Class colour, shaded a little so geometry stays readable. REFLECTION materials (blend/additive) get
                // diagonal white stripes; plain specular classes are drawn brighter than classes without RT specular.
                SurfaceMaterial m = MaterialFromPayload(p.material, p.flags);
                float shade = 0.35 + 0.65 * saturate(dot(p.normal, -ray.Direction));
                c = ClassColor(m.cls) * shade * (m.mode == ULTRART_REFL_NONE ? 0.45 : 1.0);
                if (m.mode >= ULTRART_REFL_BLEND && ((id.x + id.y) / 4u) % 2u == 0u) c = lerp(c, 1.0, 0.6);
                break;
            }
            case 9:
            {
                // r: smoothness (1 - roughness) where specular, g: metalness, b: reflection strength (REFLECTION) or
                // specular weight (specular classes).
                SurfaceMaterial m = MaterialFromPayload(p.material, p.flags);
                bool spec = m.mode != ULTRART_REFL_NONE;
                c = float3(spec ? 1.0 - m.roughness : 0.0, m.metalness, m.mode >= ULTRART_REFL_BLEND ? m.reflStrength : (spec ? m.weight : 0.0));
                break;
            }
        }
    }
    _Output[id] = float4(c, 1.0);
}

[shader("miss")]
void Miss(inout RayPayload p : SV_RayPayload)
{
    p.t = -1.0;
}
