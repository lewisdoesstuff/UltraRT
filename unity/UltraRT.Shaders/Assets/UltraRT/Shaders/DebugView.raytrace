// Primary-ray debug view: shoots one ray per pixel from the game camera and visualises what it hits.
#pragma max_recursion_depth 1

#include "UltraRTCommon.hlsl"

RaytracingAccelerationStructure _Scene;
RWTexture2D<float4> _Output;

float4x4 _InvViewProj;   // inverse(projection * view), OpenGL-style clip space
float4   _CamPos;
int      _Mode;          // 0 lit albedo, 1 albedo, 2 normals, 3 depth, 4 instance, 5 uv, 6 emission, 7 primitive
float    _DepthScale;

[shader("raygeneration")]
void RayGen()
{
    uint2 id = DispatchRaysIndex().xy;
    uint2 dim = DispatchRaysDimensions().xy;

    float2 ndc = ((float2)id + 0.5) / (float2)dim * 2.0 - 1.0;
    float4 farPt = mul(_InvViewProj, float4(ndc, 1.0, 1.0));
    farPt.xyz /= farPt.w;

    RayDesc ray;
    ray.Origin = _CamPos.xyz;
    ray.Direction = normalize(farPt.xyz - _CamPos.xyz);
    ray.TMin = 0.0;
    ray.TMax = 1.0e5;

    RayPayload p = (RayPayload)0;
    p.t = -1.0;
    TraceRay(_Scene, RAY_FLAG_CULL_BACK_FACING_TRIANGLES, 0xFF, 0, 1, 0, ray, p);

    float3 c;
    if (p.t < 0.0)
    {
        // Miss: dark magenta gradient so holes in the scene stand out.
        c = lerp(float3(0.05, 0.0, 0.08), float3(0.25, 0.0, 0.3), saturate(ray.Direction.y * 0.5 + 0.5));
    }
    else
    {
        switch (_Mode)
        {
            default:
            case 0: c = p.albedo * (0.25 + 0.75 * saturate(dot(p.normal, -ray.Direction))) + p.emission; break;
            case 1: c = p.albedo; break;
            case 2: c = p.normal * 0.5 + 0.5; if (p.flags & 1) c *= float3(1, 0.4, 0.4); break;
            case 3: c = (float3)saturate(1.0 - p.t / _DepthScale); break;
            case 4: c = HashColor(p.instance + 1); break;
            case 5: c = float3(frac(p.uv), 0); break;
            case 6: c = p.emission; break;
            case 7: c = HashColor(p.primitive * 7919u + p.instance); break;
        }
    }
    _Output[id] = float4(c, 1.0);
}

[shader("miss")]
void Miss(inout RayPayload p : SV_RayPayload)
{
    p.t = -1.0;
}
