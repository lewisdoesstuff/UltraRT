// UltraRT: inputs and output handling for NVIDIA DLSS Ray Reconstruction (docs/dlss.md). Driven by src/UltraRT/DlssRR.cs.
//
//   Prepare        render res (the visible part of the trace, guard band cropped): noisy colour, diffuse/specular albedo,
//                  normal + roughness, linear depth, 2D motion, specular hit distance, from the existing G-buffer. Also
//                  touches the RR output as a UAV so Unity tracks every resource the plugin event uses as UNORDERED_ACCESS.
//   (plugin event: DLSS-RR denoises and upscales to screen res)
//   Finish         screen res: back to display space, relight's tone curve, a = 1 where a trace sample matches the game's
//                  depth (the composite keeps the game's pixel elsewhere, as with the temporal upsampler).
//   ExposureInput  trace res: what relight's auto exposure meters (the lit part of the RR result, unexposed).
//   Demod          trace res, before Prepare: the demodulation colour (see "Remodulation").
//   RemodFinish    screen res, UltraRT's denoiser with remodulation (no RR; docs/path-tracing.md): the upsampled lighting
//                  (composite / D) x the upsampled D, tone mapped: the temporal upsampler's output for the composite.
//
// Remodulation (_RRParams2.x; docs/dlss.md, "Remodulation"). RR reconstructs texture detail from a third to a half of
// the screen's pixels, which blurs the game's point-sampled texels. So RR is given the image divided by what each
// surface shows under white light, D = albedo x keep + specular weight + emission: the "effective lighting"
// X = c / D, which has no texture in it. D is noise-free and is accumulated to screen resolution on its own by the
// temporal upsampler (exact texel hits, the game's depth as geometry; TemporalUpsampler in DlssRR.cs); Finish multiplies
// RR's output by it. Textures and silhouettes then converge to the exact texel grid at any render scale, and RR only
// has to reconstruct lighting.
//
// Colour space. Relight's linear transport makes the lighting L linear; the composite then converts it to the game's
// gamma units: c = (albedo L^(1/2.2) keep + spec) e + emission. RR wants linear HDR radiance, so it gets c^2.2 per
// noisy sample. Where only the diffuse term is present that is (albedo keep e)^2.2 * L, exactly linear in the noisy L, so
// RR averages what our denoiser averages; Finish takes the result back with ^(1/2.2), exact for noise-free input.
// (Linearising each term on its own was wrong: (a^2.2 + b^2.2)^(1/2.2) < a + b darkened reflective and emissive
// surfaces.) Gamma transport (pt-dn) feeds c directly, as our denoiser averages gamma lighting there.

#pragma kernel Prepare
#pragma kernel Finish
#pragma kernel ExposureInput
#pragma kernel Demod
#pragma kernel RemodFinish
#pragma kernel CutoutPrep

#include "UltraRTMaterial.hlsl"
#include "UltraRTCommon.hlsl" // UnpackMotion

// ---- trace inputs (trace res, guard band included)
Texture2D<float4> _Radiance;    // demodulated lighting (1 spp)
Texture2D<float4> _Albedo;      // unpacked by the reflection resolve
Texture2D<float4> _Emission;
Texture2D<float4> _Specular;    // rgb added specular term, a keep factor of the diffuse part
Texture2D<float4> _NormalDepth; // xyz normal, w ray t (< 0 sky)
Texture2D<int2>   _InstanceId;  // y packed world-space motion
Texture2D<uint4>  _Surface;     // packed material
Texture2D<float4> _Reflection;  // raw reflection: a = hit distance (-1 not traced)

float4   _Dim;          // trace w, h, 1/w, 1/h
float4   _CamPos;
float4   _CamFwd;
float4x4 _InvViewProj;  // this frame (jittered, guard band)
float4x4 _PrevViewProj; // last frame (jittered with last frame's jitter)
float4   _Jitter;       // xy this frame's sample offset (trace px), zw last frame's
int4     _Guard;        // xy guard band (trace px), zw render (visible) size
float4   _ReflParams;   // ReflectionSettings.ShaderParams (yz = SpecularTerms params)
int      _UltraRTPlayerSplit; // global (Plugin.Noise.cs): V1's shadow is a factor in _Radiance.a, not in the lighting
float4   _RRParams2;    // x remodulation on (0/1), y player shadow factor filtered before RR (0/1; PlayerShadowFactor), z emitters in front of the game's depth (Finish), w emission outside RR (remodulation only)
Texture2D<float4> _DemodTex;   // trace res: the demodulation colour D (Demod kernel)
Texture2D<float4> _DemodHi;    // screen res: D accumulated by the temporal upsampler (a = 0: no RT surface)
RWTexture2D<float4> _DemodOut;
float4   _RRParams;     // x linearize (with linear transport only; 0 = feed gamma terms), y sky depth, z history valid (0: no motion), w spec hit distance on

#include "UltraRTExposure.hlsl" // _UltraRTLinear, UltraRTPixelExposure (needs _UltraRTLitWeight bound), UltraRTToneMap, _UltraRTLinear

RWTexture2D<float4> _OutColor;
RWTexture2D<float4> _OutDiffuse;
RWTexture2D<float4> _OutSpecular;
RWTexture2D<float4> _OutNormal;   // xyz world normal, w linear roughness
RWTexture2D<float>  _OutDepth;    // linear view depth
RWTexture2D<float2> _OutMotion;   // render px, previous - current
RWTexture2D<float>  _OutHitDist;
RWTexture2D<float4> _RROutput;    // RR's output (screen res): touched here, read by Finish / ExposureInput

float3 Dir(int2 s)
{
    float2 ndc = ((float2)s + 0.5) * _Dim.zw * 2.0 - 1.0;
    return UltraRTCameraRay(_InvViewProj, ndc, _CamPos.xyz);
}

bool Linearize() { return _UltraRTLinear > 0.5 && _RRParams.x > 0.5; }
float3 Lin(float3 c) { return Linearize() ? pow(max(c, 0.0), 2.2) : max(c, 0.0); }
bool Remodulate() { return _RRParams2.x > 0.5; }
bool EmitOutside() { return _RRParams2.w > 0.5; }
static const float kDemodMin = 1.0 / 255.0;
// White diffuse reflectance given to emitting samples in RR's signal (Prepare; docs/dlss.md, "Emission outside RR").
static const float kEmitWhite = 0.05;

// The specular weight the reflection resolve applied at trace pixel s (0 where it added nothing).
float3 SpecWeight(int2 s, float4 nd, float3 dir, float3 albedo, float4 sp)
{
    if (nd.w < 0.0 || !(sp.a < 1.0 || any(sp.rgb > 0.0))) return 0;
    float NdotV = saturate(dot(normalize(nd.xyz), -dir));
    float3 specW;
    float keep;
    SpecularTerms(SurfaceMat(_Surface[s]), albedo, NdotV, _ReflParams.yz, specW, keep);
    return specW;
}

// What the surface at trace pixel s shows under white light: diffuse + specular reflectance + its emission.
[numthreads(8, 8, 1)]
void Demod(uint3 id : SV_DispatchThreadID)
{
    int2 s = (int2)id.xy;
    if (any(s >= (int2)_Dim.xy)) return;
    float4 nd = _NormalDepth[s];
    if (nd.w < 0.0) { _DemodOut[s] = float4(1, 1, 1, 1); return; }
    float3 albedo = _Albedo[s].rgb;
    float4 sp = _Specular[s];
    float3 d = albedo * sp.a + SpecWeight(s, nd, Dir(s), albedo, sp) + max(_Emission[s].rgb, 0.0);
    _DemodOut[s] = float4(min(d, 64.0), 1.0);
}

// V1's shadow factor at trace pixel s (_Radiance.a, +2 = moving-shadow flag; 1 = V1 blocks nothing).
float PlayerFactorRaw(int2 s)
{
    float a = _Radiance[s].a;
    return saturate(a > 1.5 ? a - 2.0 : a);
}

// The factor RR gets. Raw, it is one shadow ray per trace pixel: at 1/3 scale on the exact 3x3 jitter grid V1's shadow
// edge is a 0/1 step that lands on different screen pixels every frame, and RR showed it as a flickering, shifting outline
// (1-1 user pose 2026-11-15: masked burst sigma 0.75, 0.52 with V1 out of the shadow rays). Our own denoiser filters the
// factor (Denoise.compute: 5x5 same-surface mean + history) before relight's composite; here a 3x3 same-surface tent
// does the spatial part and RR's history the temporal one.
float PlayerShadowFactor(int2 s, float4 nd)
{
    float f0 = PlayerFactorRaw(s);
    if (_RRParams2.y < 0.5) return f0;
    float sum = f0 * 4.0, wsum = 4.0;
    int2 dim = (int2)_Dim.xy;
    [unroll] for (int j = 0; j < 9; j++)
    {
        if (j == 4) continue;
        int2 o = int2(j % 3 - 1, j / 3 - 1);
        int2 q = clamp(s + o, 0, dim - 1);
        float4 n = _NormalDepth[q];
        if (n.w < 0.0 || abs(n.w - nd.w) > 0.05 * nd.w + 0.05 || dot(n.xyz, nd.xyz) < 0.9) continue;
        float w = (o.x == 0 || o.y == 0) ? 2.0 : 1.0;
        sum += PlayerFactorRaw(q) * w;
        wsum += w;
    }
    return sum / wsum;
}

[numthreads(8, 8, 1)]
void Prepare(uint3 id : SV_DispatchThreadID)
{
    if (all(id.xy == 0u)) _RROutput[uint2(0, 0)] = 0; // resource-state touch (see header)
    if (any((int2)id.xy >= _Guard.zw)) return;
    int2 s = (int2)id.xy + _Guard.xy;
    float4 nd = _NormalDepth[s];
    bool sky = nd.w < 0.0;
    float3 dir = Dir(s);

    float4 rad = _Radiance[s];
    float3 L = min(max(rad.rgb, 0.0), 65000.0); // max() first drops NaN
    // Player shadow split (docs/denoiser.md, "Moving shadows"): our denoiser filters V1's shadow factor separately and
    // multiplies it in at the composite. RR gets it multiplied into its noisy input instead (+2 = moving-shadow flag).
    if (_UltraRTPlayerSplit != 0 && !sky) L *= PlayerShadowFactor(s, nd);
    float3 albedo = _Albedo[s].rgb;
    float3 emission = max(_Emission[s].rgb, 0.0);
    float4 sp = _Specular[s];
    float e = UltraRTPixelExposure((uint2)s);
    uint4 sf = _Surface[s];
    SurfaceMaterial m = SurfaceMat(sf);

    // The composite: (albedo * Disp(L) * keep + spec) * e + emission, Disp = ^(1/2.2) with linear transport.
    float3 disp = Linearize() ? pow(L, 1.0 / 2.2) : L;
    // x the area colour match (docs/relight.md, "Area colour"), as the denoiser's Composite applies it.
    float3 color = Lin((albedo * disp * sp.a + sp.rgb) * e * UltraRTPixelBalance((uint2)s) + emission);
    float3 specW = SpecWeight(s, nd, dir, albedo, sp);
    float3 diffAlb = albedo * sp.a, specAlb = specW;
    if (Remodulate())
    {
        // The lit part over its demodulation colour; the albedo guides become each lobe's share of it (they sum to 1, so
        // RR sees no texture to reconstruct). The emission stays out of RR (docs/dlss.md, "Emission outside RR"): it is
        // noise-free, and Finish adds it back at screen resolution (D's emissive share, EmitShare). In RR's signal an
        // emitter's X = (lit + E) / (albedo + E) was a step against its unlit neighbours that RR rebuilt at trace
        // resolution, as stair-stepped halos along slanted light bars (P-2, user 2026-11-20). Where a surface emits, a
        // little white diffuse (kEmitWhite) stands in for the reflectance it lacks, so its X is the light that reaches it,
        // continuous with the surface around it.
        if (EmitOutside())
        {
            float em = max(emission.r, max(emission.g, emission.b));
            float white = em > 0.0 ? kEmitWhite : 0.0;
            float3 dm = max(albedo * sp.a + specW + white, kDemodMin);
            color = Lin(((albedo * sp.a + white) * disp + sp.rgb) * e * UltraRTPixelBalance((uint2)s) / dm);
            diffAlb = (diffAlb + white) / dm;
            specAlb /= dm;
        }
        else
        {
            // Before 2026-11-21 (bench plugin._rrEmitOutside=0): the emission inside RR's signal.
            float3 dm = max(_DemodTex[s].rgb, kDemodMin);
            color = Lin((albedo * disp * sp.a + sp.rgb) * e * UltraRTPixelBalance((uint2)s) / dm + emission / dm);
            diffAlb /= dm;
            specAlb /= dm;
        }
    }
    _OutColor[id.xy] = float4(min(color, 65000.0), 1.0);
    _OutDiffuse[id.xy] = float4(sky ? 0.5.xxx : saturate(Lin(diffAlb)), 1.0);
    _OutSpecular[id.xy] = float4(sky ? 0.0.xxx : saturate(Lin(specAlb)), 1.0);
    _OutNormal[id.xy] = sky ? 0 : float4(normalize(nd.xyz), saturate(m.roughness));

    float viewZ = sky ? _RRParams.y : nd.w * dot(dir, _CamFwd.xyz);
    _OutDepth[id.xy] = viewZ;

    // Motion: where this sample's surface point was last frame minus where it is now, both unjittered, in render (= trace)
    // px. The jittered viewProj maps an unjittered position u to texel u - j, and this pixel's ray goes through
    // u = s + 0.5 + J, so: prev = projected (last jittered matrix) + last J, cur = s + 0.5 + J. A still camera gives 0.
    // Sky: direction only.
    float2 mv = 0;
    if (_RRParams.z > 0.5)
    {
        float4 pc = sky ? mul(_PrevViewProj, float4(dir, 0.0))
                        : mul(_PrevViewProj, float4(_CamPos.xyz + dir * nd.w + UnpackMotion((uint)_InstanceId[s].y), 1.0));
        if (pc.w > 1e-6)
        {
            float2 prevPx = (pc.xy / pc.w * 0.5 + 0.5) * _Dim.xy + _Jitter.zw;
            float2 curPx = (float2)s + 0.5 + _Jitter.xy;
            mv = prevPx - curPx;
        }
    }
    _OutMotion[id.xy] = mv;
    float hd = _Reflection[s].a;
    _OutHitDist[id.xy] = sky ? 65504.0 : (hd >= 0.0 ? hd : 0.0);
}

// ---- Finish / ExposureInput
Texture2D<float4> _RRColor;   // RR output (screen res)
Texture2D<float>  _GameDepth; // the game's raw device depth (screen res)
RWTexture2D<float4> _Final;   // screen res: rgb displayed colour, a 1 = RT pixel
// HDR bloom source (docs/vfx.md), screen res, linear light: what the tone curve compressed plus bright emission, as
// Denoise.compute's Composite writes it for the other denoiser. A 1x1 dummy is bound when nobody wants it.
RWTexture2D<float4> _BloomOut;
float4 _BloomParams; // x weight of the compressed energy, y weight of bright emission, z/w emission threshold (lo, hi)
float  _BloomOn;
// HDR display gain map (docs/hdr.md), screen res: rgb = HDR / SDR per channel, a = the SDR luma. A 1x1 dummy when off.
RWTexture2D<float4> _HdrOut;
float4 _HdrParams; // x on, y display peak (display gamma, 1 = SDR white), z value that reaches the peak (0 = the white point), w largest gain
float4 _HdrEmissive; // x glowing surfaces' HDR boost - 1, y / z brightness where it starts / is full (UltraRTHdrEmissive), w highlight colour mode (UltraRTHdrGain)
Texture2D<float4> _HdrGameColor; // the game's frame before the composite (screen res), for those pixels' expected colour
float4 _HdrGame;     // pixels the game draws itself (a = 0): linear HDR factor for their bright parts; x in front of the traced scene (lava, acid), y sky
RWTexture2D<float4> _AEFiltered;
RWTexture2D<float4> _AEAlbedo;
float4 _OutDim;   // W, H, 1/W, 1/H
float4 _TraceMap; // xy trace px per screen px, zw guard band (trace px)
float4 _TraceRay; // xy trace ndc -> view ray slope
float4 _ZParams;  // eye depth = 1 / (z * raw + w)
float4 _Match2;   // x: nearest-depth fallback for thin geometry (relative depth tolerance over the 5x5; 0 = off); y: 1 = _Cutout is valid; z: cutout debug; w: Finish debug (1 D, 2 X)
Texture2D<float4> _Cutout; // screen res (CutoutTrace.raytrace): rgb the albedo of the blade a screen-res camera ray found up to the game's depth, a -(its view depth + 8) (> -8: none; -1..-4 why, for the debug view)
float4 _Match;    // x depth tolerance (relative), y (absolute, m), z plane test: allowed bend of 1/z (relative; 0 = off), w slope tolerance in trace texels (0 = off; also turns on thin geometry from the screen-resolution history)
float4 _RRMap;    // xy RR output px per screen px (1 unless the bench's 1440p cost probe renders RR larger), zw RR size
int4   _RROffset; // xy: where screen pixel (0, 0) is in the RR output (exact-grid mode: the output overscans the screen)

float3 RRAt(int2 p) { return _RRColor[min((int2)(((float2)p + 0.5) * _RRMap.xy) + _RROffset.xy, (int2)_RRMap.zw - 1)].rgb; }

float3 Display(float3 c) { return Linearize() ? pow(max(c, 0.0), 1.0 / 2.2) : max(c, 0.0); }

// The emissive share of a screen pixel's demodulation colour d (D = reflectance + emission; docs/dlss.md, "Emission
// outside RR"): E / D of the trace sample whose D is nearest d, among the 3x3 around kn. d is the screen-resolution
// history, so the share follows the texel edges of d, not the trace grid. kHit alone when the pixel took that sample's D.
float3 EmitShare(int2 kn, int2 tdim, int2 kHit, float3 d, bool own)
{
    float3 share = 0;
    if (own)
    {
        float3 e0 = max(_Emission[kHit].rgb, 0.0);
        share = saturate(e0 / max(_DemodTex[kHit].rgb, kDemodMin));
    }
    else
    {
        // Most pixels have no emitter nearby: the emission alone first (9 taps), D only where something emits.
        float3 ek[9];
        bool anyE = false;
        [unroll] for (int j = 0; j < 9; j++)
        {
            ek[j] = max(_Emission[clamp(kn + int2(j % 3 - 1, j / 3 - 1), 0, tdim - 1)].rgb, 0.0);
            anyE = anyE || any(ek[j] > 0.0);
        }
        [branch] if (anyE)
        {
            float best = 1e9;
            [unroll] for (int j2 = 0; j2 < 9; j2++)
            {
                float3 dk = max(_DemodTex[clamp(kn + int2(j2 % 3 - 1, j2 / 3 - 1), 0, tdim - 1)].rgb, kDemodMin);
                float diff = dot(abs(dk - d), 1.0.xxx);
                if (diff < best) { best = diff; share = saturate(ek[j2] / dk); }
            }
        }
    }
    return share;
}

[numthreads(8, 8, 1)]
void Finish(uint3 id : SV_DispatchThreadID)
{
    int2 p = (int2)id.xy;
    if (any(p >= (int2)_OutDim.xy)) return;
    float3 hdr = Display(RRAt(p));
    float3 c = saturate(UltraRTToneMap(hdr));

    float zg = 1.0 / (_ZParams.z * _GameDepth[p] + _ZParams.w);
    float tol = zg * _Match.x + _Match.y;
    float2 q = ((float2)p + 0.5) * _TraceMap.xy + _TraceMap.zw;
    int2 kn = (int2)floor(q - _Jitter.xy);
    int2 tdim = (int2)_Dim.xy;
    float a = 0;
    int2 kHit = clamp(kn, 0, tdim - 1);
    float3 emitHi = -1.0; // remodulation: this pixel's emission at screen resolution (EmitShare); < 0: the trace sample's
    // A floor at a grazing angle: its depth changes by more than the tolerance from one trace texel to the next, so no
    // sample matched and the game's pixel was kept, as bright rows on far floors and ledges (7-1, user 2026-11-18).
    // 1 / view depth is linear on the screen for a plane: predict it at this pixel from the centre sample and its four
    // neighbours, if those lie on one plane (no bend), and compare that.
    float wS[9];
    [unroll] for (int j = 0; j < 9; j++)
    {
        int2 k = clamp(kn + int2(j % 3 - 1, j / 3 - 1), 0, tdim - 1);
        float t = _NormalDepth[k].w;
        if (t < 0.0) continue;
        float2 ndc = ((float2)k + 0.5 + _Jitter.xy) * _Dim.zw * 2.0 - 1.0;
        float rayLen = length(float3(ndc * _TraceRay.xy, 1.0));
        float z = t / rayLen;
        int ix = _InstanceId[k].x;
        uint pt = (uint)ix >> 16;
        // A surface seen edge-on (a grass blade's quad, a ledge's side) changes depth fast across one texel, and the
        // game's raster and the ray never land on exactly the same place: allow what one texel's step can change,
        // z x texel angle x tan(angle to the normal). Without it the game's pixel was kept there (7-1's grass: white
        // blades, sparkling as the jitter moved; user 2026-11-18).
        float tolK = tol;
        if (_Match.w > 0.0)
        {
            float cn = abs(dot(normalize(_NormalDepth[k].xyz + 1e-6), Dir(k)));
            tolK += z * (2.0 * _TraceRay.y * _Dim.w) * _Match.w * sqrt(saturate(1.0 - cn * cn)) / max(cn, 0.05);
        }
        bool hit = abs(z - zg) <= tolK;
        if (!hit && ix > 65535 && pt != 0u) hit = abs(f16tof32(pt) / rayLen - zg) <= tol; // portal plane (docs/portals.md)
        if (hit) { a = 1; kHit = k; break; }
    }
    if (a == 0.0 && _Match.z > 0.0)
    {
        [unroll] for (int j2 = 0; j2 < 9; j2++)
        {
            int2 k = clamp(kn + int2(j2 % 3 - 1, j2 / 3 - 1), 0, tdim - 1);
            float t = _NormalDepth[k].w;
            float2 ndc = ((float2)k + 0.5 + _Jitter.xy) * _Dim.zw * 2.0 - 1.0;
            float rayLen = length(float3(ndc * _TraceRay.xy, 1.0));
            int ix = _InstanceId[k].x;
            uint pt = (uint)ix >> 16;
            float zs = (ix > 65535 && pt != 0u) ? f16tof32(pt) / rayLen : t / rayLen;
            wS[j2] = t < 0.0 ? -1.0 : 1.0 / max(zs, 1e-4);
        }
        float wc = wS[4];
        if (wc > 0.0 && wS[1] > 0.0 && wS[3] > 0.0 && wS[5] > 0.0 && wS[7] > 0.0
            && abs(wS[3] + wS[5] - 2.0 * wc) <= wc * _Match.z && abs(wS[1] + wS[7] - 2.0 * wc) <= wc * _Match.z)
        {
            float2 d = q - ((float2)kn + 0.5 + _Jitter.xy);
            float wp = wc + 0.5 * (wS[5] - wS[3]) * d.x + 0.5 * (wS[7] - wS[1]) * d.y;
            if (wp > 1e-5 && abs(1.0 / wp - zg) <= tol) { a = 1; kHit = clamp(kn, 0, tdim - 1); }
        }
    }
    // A glowing surface in front of the game's depth (_RRParams2.z, remodulation only): the trace sample covering this pixel
    // emits and lies nearer than the game's surface by more than the tolerance. The game draws something there that its
    // depth buffer lacks (Gabriel's swords: drawn, but not in the depth the composite reads), so the match above found the
    // wall behind it, and the screen-resolution colour below was the wall's: it showed through the blade. Take this sample,
    // with its own colour. Only emitters: what the game draws over a traced surface keeps the game's pixel, and a general
    // "in front" rule turned 1-3's lava yellow (docs/path-tracing.md, "Nearest-depth fallback"). docs/dlss.md, "Emitters
    // in front of the game's depth".
    bool frontEm = false;
    if (_RRParams2.z > 0.5 && Remodulate())
    {
        int2 k = clamp(kn, 0, tdim - 1);
        float t = _NormalDepth[k].w;
        float3 ek = max(_Emission[k].rgb, 0.0);
        if (t >= 0.0 && max(ek.r, max(ek.g, ek.b)) > 0.05)
        {
            float2 ndc = ((float2)k + 0.5 + _Jitter.xy) * _Dim.zw * 2.0 - 1.0;
            float z = t / length(float3(ndc * _TraceRay.xy, 1.0));
            if (z < zg - tol) { a = 1; kHit = k; frontEm = true; }
        }
    }
    // Cutout pass: no trace sample matched, but the screen-res camera ray found an alpha-tested surface up to the game's
    // depth (a grass blade, a grate bar the trace missed): a traced pixel with its colour and RR's lighting here.
    bool cutHit = false;
    float4 cut = 0;
    if (a == 0.0 && _Match2.y > 0.5 && Remodulate())
    {
        cut = _Cutout[p];
        // a <= -8: a blade at -(a + 8), taken also in front of the game's depth (docs/path-tracing.md, "Cutout pass"); the
        // a > 0 case (any surface, matched by depth) is from the whole-scene version and no longer written.
        bool cutout = cut.a <= -8.0;
        float zc = cutout ? -cut.a - 8.0 : cut.a;
        cutHit = (cut.a > 0.0 || cutout) && (abs(zc - zg) <= tol || (cutout && zc < zg));
        if (cutHit) a = 1;
    }
    // Debug (plugin._cutoutDebug=1): the pixels the game keeps, by what the cutout ray found. Blue: no blade in front of
    // the game's surface, yellow: a fullbright blade, cyan: an emitter, grey: the ray didn't run (prep skipped it, or no
    // pass); green tint: pixels the pass made traced. (Red, orange, magenta: whole-scene version only.)
    if (_Match2.z > 0.5 && _Match2.z < 1.5 && _Match2.y > 0.5)
    {
        float4 cd = _Cutout[p];
        if (cd.a <= -8.0) cd.a = -cd.a - 8.0;
        if (cutHit) { _Final[p] = float4(0.2, 1.0, 0.2, 1.0); return; }
        if (a == 0.0)
        {
            float3 col = cd.a > 0.0 ? (cd.a > zg ? float3(1, 0, 0) : float3(1, 0.5, 0))
                       : cd.a == -1.0 ? float3(0, 0.3, 1) : cd.a == -2.0 ? float3(1, 0, 1) : cd.a == -3.0 ? float3(1, 1, 0)
                       : cd.a == -4.0 ? float3(0, 1, 1) : float3(0.5, 0.5, 0.5);
            _Final[p] = float4(col, 1.0);
            return;
        }
    }
    if (Remodulate())
    {
        // Back to the image: x the demodulation colour at screen resolution (the matching trace sample's where the
        // upsampler has nothing yet).
        float4 dh = _DemodHi[p];
        // Geometry thinner than a trace texel (grass blades, ledge tops): no sample of this frame matches the game's
        // depth, but the screen-resolution history has this pixel's surface from an earlier jitter. Then it is a
        // traced pixel: RR's lighting x that colour, not the game's own pixel (7-1's grass sparkled with them).
        if (a == 0.0 && _Match.w > 0.0 && dh.a > 0.0) a = 1;
        // Still nothing: a blade no ray hit this frame or before. The game's pixel there is lit by the game (7-1: white in
        // its fog) and sparkled against the traced blades. Take the 5x5's sample nearest the game's depth, if close
        // enough (a neighbouring blade), as this pixel's surface: RR's lighting here x its colour. Only samples in front
        // of the game's pixel or level with it (1 %): what the game draws over a traced surface behind it (lava over its
        // bed, 1-3) keeps the game's pixel.
        if (a == 0.0 && _Match2.x > 0.0 && _GameDepth[p] > 0.0)
        {
            float best = 1e9;
            int2 kb = kHit;
            [unroll] for (int j3 = 0; j3 < 25; j3++)
            {
                int2 k = clamp(kn + int2(j3 % 5 - 2, j3 / 5 - 2), 0, tdim - 1);
                float t = _NormalDepth[k].w;
                if (t < 0.0) continue;
                float2 ndc = ((float2)k + 0.5 + _Jitter.xy) * _Dim.zw * 2.0 - 1.0;
                float dz = t / length(float3(ndc * _TraceRay.xy, 1.0)) - zg;
                if (dz > zg * 0.01) continue; // behind the game's pixel
                if (abs(dz) < best) { best = abs(dz); kb = k; }
            }
            if (best <= zg * _Match2.x) { a = 1; kHit = kb; }
        }
        float3 dpix = cutHit ? cut.rgb : frontEm ? _DemodTex[kHit].rgb : dh.a > 0.0 ? dh.rgb : _DemodTex[kHit].rgb;
        // D = reflectance + emission; RR's X lights the reflectance only (Prepare), the emission is D's emissive share.
        float3 share = cutHit || !EmitOutside() ? 0.0 : EmitShare(kn, tdim, kHit, dpix, frontEm || dh.a <= 0.0);
        hdr = Display(RRAt(p)) * (dpix - dpix * share) + dpix * share;
        if (EmitOutside()) emitHi = dpix * share;
        c = saturate(UltraRTToneMap(hdr));
        // Diagnostics (_Match2.w, DlssRR.FinishDebug): the two factors on their own. 1 = D (tone mapped), 2 = RR's X x 0.5.
        if (_Match2.w > 0.5 && a > 0.0)
        {
            float3 dbg = _Match2.w < 1.5 ? saturate(UltraRTToneMap(cutHit ? cut.rgb : frontEm ? _DemodTex[kHit].rgb : dh.a > 0.0 ? dh.rgb : _DemodTex[kHit].rgb)) : saturate(Display(RRAt(p)) * 0.5);
            _Final[p] = float4(dbg, 1.0);
            return;
        }
    }
    if (_BloomOn > 0.5)
    {
        float3 b = 0;
        if (a > 0.0)
        {
            float3 excess = max(pow(max(hdr, 0.0), 2.2) - pow(c, 2.2), 0.0);
            float3 em = max(emitHi.x >= 0.0 ? emitHi : _Emission[kHit].rgb, 0.0);
            float ew = smoothstep(_BloomParams.z, _BloomParams.w, max(em.r, max(em.g, em.b)));
            b = excess * _BloomParams.x + pow(em, 2.2) * (ew * _BloomParams.y);
            if (any(isnan(b)) || any(isinf(b))) b = 0;
        }
        _BloomOut[p] = float4(min(b, 64.0), 1.0);
    }
    if (_HdrParams.x > 1.5)
    {
        // Native float HDR (docs/hdr.md): _Final (ARGBHalf) gets the scene value (UltraRTHdrScene). A pixel the game draws itself (lava
        // and acid, which the camera's rays skip; the sky) is the game's colour from right before the composite with its
        // bright part scaled (HDRLava / HDRSky, display units here), marked a = -1 so the composite writes it (and the
        // volumetric fog, which the game already applied there, still skips it).
        if (a > 0.0)
            c = UltraRTHdrScene(hdr, UltraRTHdrEmissive(emitHi.x >= 0.0 ? emitHi : max(_Emission[kHit].rgb, 0.0), hdr, _HdrEmissive), _UltraRTTonemapWhite, _UltraRTTonemapParams);
        else
        {
            float gb = _NormalDepth[clamp(kn, 0, tdim - 1)].w < 0.0 ? _HdrGame.y : _HdrGame.x;
            float3 gc = _HdrGameColor[p].rgb;
            gc = min(max(gc, 0.0), 64.0); // no NaN, no infinity (min / max drop a NaN on D3D)
            float t = smoothstep(0.7, 1.0, max(gc.r, max(gc.g, gc.b)));
            if (gb > 1.0 && t > 0.0) { c = gc * (1.0 + (gb - 1.0) * t * t); a = -1.0; }
        }
    }
    else if (_HdrParams.x > 0.5)
    {
        // Not an RT pixel: the game's own pixel shows (the composite discards). A negative a marks it (-(its packed colour
        // + 1)); r = the factor the present pass applies to its bright part. The camera's rays skip lava and acid
        // (docs/lava.md), so those are "in front".
        float gb = _NormalDepth[clamp(kn, 0, tdim - 1)].w < 0.0 ? _HdrGame.y : _HdrGame.x;
        _HdrOut[p] = a > 0.0 ? UltraRTHdrGain(hdr, c, UltraRTHdrEmissive(emitHi.x >= 0.0 ? emitHi : max(_Emission[kHit].rgb, 0.0), hdr, _HdrEmissive), _UltraRTTonemapWhite, _UltraRTTonemapParams, _HdrParams, _HdrEmissive.w)
                             : float4(max(gb, 1.0), 1.0, 1.0, -(UltraRTHdrPack(_HdrGameColor[p].rgb) + 1.0));
    }
    // Debug (plugin._matchDebug=1): the pixels the game keeps, by the relative depth of the 5x5's trace sample nearest the
    // game's depth: red behind the game's surface, blue in front, full at 10 %; dark green: no sample.
    if (_Match2.z > 1.5 && a == 0.0)
    {
        float best = 1e9, bestS = 0.0;
        [unroll] for (int j4 = 0; j4 < 25; j4++)
        {
            int2 k = clamp(kn + int2(j4 % 5 - 2, j4 / 5 - 2), 0, tdim - 1);
            float t = _NormalDepth[k].w;
            if (t < 0.0) continue;
            float2 ndc = ((float2)k + 0.5 + _Jitter.xy) * _Dim.zw * 2.0 - 1.0;
            float dz = (t / length(float3(ndc * _TraceRay.xy, 1.0)) - zg) / max(zg, 1e-4);
            if (abs(dz) < best) { best = abs(dz); bestS = dz; }
        }
        c = best > 1e8 ? float3(0, 0.25, 0) : float3(saturate(bestS * 10.0), 0.0, saturate(-bestS * 10.0));
        a = 1;
    }
    _Final[p] = float4(c, a);
}

Texture2D<float4> _RemodX; // screen res: the upsampled composite / D (pre tone curve), a = upsampler weight (0: no RT surface)

[numthreads(8, 8, 1)]
void RemodFinish(uint3 id : SV_DispatchThreadID)
{
    int2 p = (int2)id.xy;
    if (any(p >= (int2)_OutDim.xy)) return;
    float4 x = _RemodX[p];
    if (x.a <= 0.0) { _Final[p] = 0; return; }
    float4 dh = _DemodHi[p];
    // Where the D upsampler has nothing yet: the trace sample nearest the pixel centre.
    int2 k = clamp((int2)floor(((float2)p + 0.5) * _TraceMap.xy + _TraceMap.zw - _Jitter.xy), 0, (int2)_Dim.xy - 1);
    float3 d = dh.a > 0.0 ? dh.rgb : _DemodTex[k].rgb;
    float3 hdr = max(x.rgb, 0.0) * d;
    float3 c = saturate(UltraRTToneMap(hdr));
    // Native float HDR (docs/hdr.md): the scene value (no HDREmissive here: the emission isn't bound).
    if (_UltraRTHdrNative.x > 0.5) c = UltraRTHdrScene(hdr, 1.0, _UltraRTTonemapWhite, _UltraRTTonemapParams);
    _Final[p] = float4(c, x.a);
}

[numthreads(8, 8, 1)]
void ExposureInput(uint3 id : SV_DispatchThreadID)
{
    int2 s = (int2)id.xy;
    if (any(s >= (int2)_Dim.xy)) return;
    float2 screen = ((float2)s + 0.5 + _Jitter.xy - _TraceMap.zw) / _TraceMap.xy;
    int2 p = clamp((int2)floor(screen), 0, (int2)_OutDim.xy - 1);
    float3 g = Display(RRAt(p));
    // Remodulated, X lights the reflectance only (Prepare: the emission stays out of RR): the lit part is X x (D - E).
    if (Remodulate() && EmitOutside()) g *= max(_DemodTex[s].rgb - max(_Emission[s].rgb, 0.0), 0.0);
    else
    {
        if (Remodulate()) g *= _DemodTex[s].rgb;
        g = max(g - max(_Emission[s].rgb, 0.0), 0.0);
    }
    float e = UltraRTPixelExposure((uint2)s);
    // The unexposed lit part, in display units, without the colour match gain (the meter compares it with the game).
    float3 v = g / max(e * UltraRTPixelBalance((uint2)s), 1e-4);
    // Exposure.compute meters albedo * Disp(filtered) * keep + spec: give it albedo 1, no spec, filtered = Disp^-1(v).
    _AEFiltered[s] = float4(_UltraRTLinear > 0.5 ? pow(v, 2.2) : v, 0.0);
    _AEAlbedo[s] = 1.0;
}

// ---------------------------------------------------------------- cutout pass (CutoutTrace.raytrace)

RWTexture2D<float> _CutoutPrepOut; // screen res: the game's view depth where the cutout ray should run, 0 where not

// The pixels the cutout ray needs: not the game's sky, the nearest trace sample not an emitter or fullbright (lava,
// sprites, screens: the game draws those over or in front of our surface, and the ray would land on the emitter and be
// thrown away; 1-3's lava sent a ray from every pixel), and no trace sample of the 3x3 at the game's depth (Finish's
// plain match). Ray tracing shaders can't read the depth buffer, so this hands them the depth too.
[numthreads(8, 8, 1)]
void CutoutPrep(uint3 id : SV_DispatchThreadID)
{
    int2 p = (int2)id.xy;
    if (any(p >= (int2)_OutDim.xy)) return;
    float raw = _GameDepth[p];
    if (raw <= 0.0) { _CutoutPrepOut[p] = 0.0; return; }
    float zg = 1.0 / (_ZParams.z * raw + _ZParams.w);
    float tol = zg * _Match.x + _Match.y;
    float2 q = ((float2)p + 0.5) * _TraceMap.xy + _TraceMap.zw;
    int2 kn = (int2)floor(q - _Jitter.xy);
    int2 tdim = (int2)_Dim.xy;
    if (any(_Emission[clamp((int2)floor(q - _Jitter.xy), 0, tdim - 1)].rgb > 0.0)) { _CutoutPrepOut[p] = 0.0; return; }
    [unroll] for (int j = 0; j < 9; j++)
    {
        int2 k = clamp(kn + int2(j % 3 - 1, j / 3 - 1), 0, tdim - 1);
        float t = _NormalDepth[k].w;
        if (t < 0.0) continue;
        float2 ndc = ((float2)k + 0.5 + _Jitter.xy) * _Dim.zw * 2.0 - 1.0;
        if (abs(t / length(float3(ndc * _TraceRay.xy, 1.0)) - zg) <= tol) { _CutoutPrepOut[p] = 0.0; return; }
    }
    _CutoutPrepOut[p] = zg;
}
