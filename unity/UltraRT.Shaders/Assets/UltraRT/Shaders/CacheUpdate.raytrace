// Radiance cache debug views ("cache", "cache-cells"; RadianceCache.DispatchDebug). The cache itself is updated by
// PathTrace.raytrace's own paths (folded); this file's separate update pass (UpdateRayGen) was removed on 2026-11-23.
// UAV: _CacheDebugOut. See docs/radiance-cache.md.
#pragma max_recursion_depth 1

#include "UltraRTCommon.hlsl"

RaytracingAccelerationStructure _Scene;
#include "UltraRTPortals.hlsl" // TraceScene: rays follow portals (docs/portals.md)
float4x4 _InvViewProj;
float4   _CamPos;
float    _LightScale; // declared for UltraRTLights.hlsl; the debug views do not light anything
float    _EmissionScale;

RWTexture2D<float4> _CacheDebugOut;
int      _CacheDebug;     // 1 radiance, 2 lighting, 3 indirect, 4 cells, 5 samples

// ---------------------------------------------------------------- shared helpers (as in PathTrace.raytrace)

uint Pcg(inout uint s)
{
    s = s * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
    return (w >> 22u) ^ w;
}

float Rand(inout uint s) { return Pcg(s) * (1.0 / 4294967296.0); }

#include "UltraRTLights.hlsl" // LightToDisplay
#include "UltraRTCache.hlsl"

bool TracePrimary(float2 pixel, float2 dim, out RayDesc ray, out RayPayload p)
{
    float2 ndc = pixel / dim * 2.0 - 1.0;
    ray.Origin = _CamPos.xyz;
    ray.Direction = UltraRTCameraRay(_InvViewProj, ndc, _CamPos.xyz);
    ray.TMin = 0.0;
    ray.TMax = 1.0e5;
    float travelled;
    TraceScene(RAY_FLAG_CULL_BACK_FACING_TRIANGLES, ULTRART_MASK_SCENE, ray, p, travelled); // ray: the last segment after portals
    return p.t >= 0.0;
}

// ---------------------------------------------------------------- debug view

float3 Heat(float x)
{
    x = saturate(x);
    return saturate(float3(1.5 - abs(x * 4.0 - 3.0), 1.5 - abs(x * 4.0 - 2.0), 1.5 - abs(x * 4.0 - 1.0)));
}

// Writes over PathTrace's output (same size, pixel centres). Misses are a dark magenta checker.
[shader("raygeneration")]
void DebugRayGen()
{
    uint2 id = DispatchRaysIndex().xy;
    uint2 dimu = DispatchRaysDimensions().xy;
    RayDesc ray;
    RayPayload p;
    if (!TracePrimary((float2)id + 0.5, (float2)dimu, ray, p)) return; // sky: the composite keeps the game's sky

    float3 pos = ray.Origin + ray.Direction * p.t;
    float3 n = p.normal;
    float3 missColor = ((id.x / 8u + id.y / 8u) & 1u) != 0u ? float3(0.25, 0.0, 0.25) : float3(0.12, 0.0, 0.12);
    float shade = 0.4 + 0.6 * saturate(dot(n, -ray.Direction));

    float lf = CacheLevelF(pos);
    int level = min((int)lf, ULTRART_CACHE_MAX_LEVEL);
    uint bucket, check, slot;
    CacheKey(pos, n, level, bucket, check);
    bool found = CacheFind(bucket, check, slot);
    float3 total = 0, indirect = 0;
    float M = 0;
    if (found) CacheDecode(_CacheResolved[slot], total, indirect, M);

    float3 c;
    switch (_CacheDebug)
    {
        default:
        case 1: c = found ? p.albedo * lerp(1.0, LightToDisplay(total), p.alpha) + PayloadEmission(p) * _EmissionScale : missColor; break;
        case 2: c = found ? LightToDisplay(total) : missColor; break;
        case 3: c = found ? LightToDisplay(indirect) : missColor; break;
        case 4:
        {
            // Hash colour per cell, darker on odd levels so LOD rings show; misses (not in the table) are grey.
            float3 hc = HashColor(check);
            c = (found ? hc : float3(0.3, 0.3, 0.3)) * shade * ((level & 1) != 0 ? 0.6 : 1.0);
            break;
        }
        case 5: c = found ? Heat(log2(1.0 + M) / 10.0) * shade : missColor; break; // 1 .. ~1000 samples
    }
    _CacheDebugOut[id] = float4(c, 1.0);
}

[shader("miss")]
void Miss(inout RayPayload p : SV_RayPayload)
{
    p.t = -1.0;
}
