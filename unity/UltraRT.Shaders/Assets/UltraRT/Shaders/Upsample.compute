// UltraRT temporal upsampler (TAAU) for the replace modes (pt-dn, relight, dn-*): docs/denoiser.md, "Temporal upsampling".
// Driven by src/UltraRT/TemporalUpsampler.cs.
//
// The trace runs at a fraction of the screen resolution with a per-frame sub-pixel jitter (at scale 0.5: the 4 screen
// pixels of each 2x2 block in turn, so every screen pixel centre is traced exactly once per 4 frames). This pass
// accumulates the denoiser's final RT colour into a screen-resolution history:
//   - the game's own depth buffer (full resolution) is the geometry: it decides which trace samples belong to the surface
//     under each screen pixel (depth match, as the old composite did) and gives the exact world position to reproject;
//   - motion comes from the matching trace sample (_InstanceId.y), history taps are validated against their stored depth;
//   - new samples are weighted by their distance to the pixel centre (an exact hit counts fully, neighbours barely), so
//     texture detail and silhouettes converge to screen resolution;
//   - the history is clipped to the matching samples' colour box (lighting changes, animated textures);
//   - where there is no valid history, an edge-aware (depth-matched) Gaussian of the nearby samples fills in;
//   - where no trace sample matches this frame but the history is valid (thin wires, railings, a sliver of a silhouette
//     the jittered grid missed), the history is kept, so thin geometry no longer alternates between RT and game shading.
// Output: rgb colour, a accumulated sample weight (0 = no RT surface here: the composite keeps the game's pixel).

#pragma kernel Taau

#include "UltraRTCommon.hlsl" // UnpackMotion

Texture2D<float4> _Color;       // trace res: final RT colour (the denoiser's composite output), at jittered positions
Texture2D<float4> _NormalDepth; // trace res: w = ray t along the normalized primary direction (< 0 = sky)
Texture2D<int2>   _InstanceId;  // trace res: y = packed world-space motion (prev - cur; 0 = static)
Texture2D<float>  _GameDepth;   // screen res: the game's raw device depth at the injection point
Texture2D<float4> _HistIn;      // screen res: rgb colour, a accumulated weight (0 = no RT surface)
Texture2D<float>  _HistDepthIn; // screen res: last frame's eye depth
RWTexture2D<float4> _HistOut;
RWTexture2D<float>  _HistDepthOut;
SamplerState sampler_linear_clamp;

float4 _OutDim;    // W, H, 1/W, 1/H (screen)
float4 _TraceDim;  // w, h, 1/w, 1/h (trace, guard band included)
float4 _TraceMap;  // xy trace px per screen px, zw guard band (trace px): sample index space q = (x + 0.5) * xy + zw
float4 _Jitter;    // xy this frame's sample offset from the trace texel centre (trace px)
float4 _TraceRay;  // xy: trace ndc -> view ray slope (guard scale / P00, guard scale / P11)
float4 _ZParams;   // eye depth = 1 / (z * raw + w)  (Unity's _ZBufferParams for this camera)
float4x4 _InvScreenVP;  // (projection * worldToCamera)^-1, screen (no guard band, no jitter)
float4x4 _PrevScreenVP; // last frame's projection * worldToCamera
float4 _CamPos;
float4 _CamFwd;
float4 _Params;    // x exact-hit sharpness (exp(-x d^2), d in screen px), y max history weight, z spatial falloff (exp(-z d^2)), w history valid
float4 _Params2;   // x depth match tolerance (relative), y (absolute, m), z clip box padding (fraction of its size), w min matching samples to clip
float4 _Params3;   // x reprojection depth tolerance (relative), y Catmull-Rom history (0/1), z weight added by the spatial estimate, w debug view
float4 _Params4;   // x min history weight to hold a pixel without a sample, y hold decay per frame

#define TILE 11 // 8 screen px span at most 8 trace px (scale <= 1) + the 3x3 neighbourhood
#define TILE_N (TILE * TILE)
groupshared float4 gsColZ[TILE_N];  // rgb colour, a eye depth (< 0: sky)
groupshared float2 gsPos[TILE_N];   // sample position in screen px
groupshared uint   gsMotion[TILE_N];

float3 ReconstructWorld(float2 ndc, float eyeZ)
{
    float4 f = mul(_InvScreenVP, float4(ndc, 1.0, 1.0));
    float3 dir = f.xyz / f.w - _CamPos.xyz;
    return _CamPos.xyz + dir * (eyeZ / dot(dir, _CamFwd.xyz));
}

// 5-tap Catmull-Rom of the history colour (bilinear taps; the 4 corner taps are dropped and the rest renormalised).
float3 HistoryCatmullRom(float2 uv)
{
    float2 sp = uv * _OutDim.xy;
    float2 t1 = floor(sp - 0.5) + 0.5;
    float2 f = sp - t1;
    float2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    float2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    float2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    float2 w3 = f * f * (-0.5 + 0.5 * f);
    float2 w12 = w1 + w2;
    float2 t12 = (t1 + w2 / w12) * _OutDim.zw;
    float2 t0 = (t1 - 1.0) * _OutDim.zw;
    float2 t3 = (t1 + 2.0) * _OutDim.zw;
    float3 c = _HistIn.SampleLevel(sampler_linear_clamp, float2(t12.x, t0.y), 0).rgb * (w12.x * w0.y)
             + _HistIn.SampleLevel(sampler_linear_clamp, float2(t0.x, t12.y), 0).rgb * (w0.x * w12.y)
             + _HistIn.SampleLevel(sampler_linear_clamp, t12, 0).rgb * (w12.x * w12.y)
             + _HistIn.SampleLevel(sampler_linear_clamp, float2(t3.x, t12.y), 0).rgb * (w3.x * w12.y)
             + _HistIn.SampleLevel(sampler_linear_clamp, float2(t12.x, t3.y), 0).rgb * (w12.x * w3.y);
    float wsum = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    return c / wsum;
}

[numthreads(8, 8, 1)]
void Taau(uint3 id : SV_DispatchThreadID, uint3 gid : SV_GroupID, uint gi : SV_GroupIndex)
{
    // ---- this group's trace samples (3x3 neighbourhood of every pixel) into groupshared memory
    float2 J = _Jitter.xy;
    int2 groupPx = (int2)gid.xy * 8;
    int2 kb = (int2)floor(((float2)groupPx + 0.5) * _TraceMap.xy + _TraceMap.zw - J) - 1;
    int2 tdim = (int2)_TraceDim.xy;
    for (uint i = gi; i < TILE_N; i += 64)
    {
        int2 k = clamp(kb + int2(i % TILE, i / TILE), 0, tdim - 1);
        float2 sp = (float2)k + 0.5 + J;                       // trace px
        float t = _NormalDepth[k].w;
        float2 ndc = sp * _TraceDim.zw * 2.0 - 1.0;
        float z = t < 0.0 ? -1.0 : t / length(float3(ndc * _TraceRay.xy, 1.0));
        gsColZ[i] = float4(_Color[k].rgb, z);
        gsPos[i] = (sp - _TraceMap.zw) / _TraceMap.xy;          // screen px
        gsMotion[i] = (uint)_InstanceId[k].y;
    }
    GroupMemoryBarrierWithGroupSync();

    int2 p = (int2)id.xy;
    if (any(p >= (int2)_OutDim.xy)) return;
    float2 pc = (float2)p + 0.5;
    float raw = _GameDepth[p];
    float zg = 1.0 / (_ZParams.z * raw + _ZParams.w);

    // ---- current samples: depth-matched 3x3 around the nearest sample
    int2 kn = (int2)floor(pc * _TraceMap.xy + _TraceMap.zw - J);
    int2 lb = kn - 1 - kb; // local index of the 3x3's corner
    float tol = zg * _Params2.x + _Params2.y;
    float3 sumE = 0, sumS = 0, mn = 1e5, mx = -1e5;
    float wE = 0, wS = 0, bestErr = 1e30;
    uint motion = 0;
    int n = 0;
    [unroll] for (int j = 0; j < 9; j++)
    {
        int2 l = clamp(lb + int2(j % 3, j / 3), 0, TILE - 1);
        uint li = (uint)(l.y * TILE + l.x);
        float4 cz = gsColZ[li];
        float err = abs(cz.a - zg);
        if (cz.a < 0.0 || err > tol) continue;
        float2 d = gsPos[li] - pc;
        float d2 = dot(d, d);
        float we = exp(-_Params.x * d2);
        float ws = exp(-_Params.z * d2);
        sumE += cz.rgb * we; wE += we;
        sumS += cz.rgb * ws; wS += ws;
        mn = min(mn, cz.rgb); mx = max(mx, cz.rgb);
        n++;
        if (err < bestErr) { bestErr = err; motion = gsMotion[li]; }
    }

    // ---- history: reproject the game's surface point (plus the matching sample's object motion)
    float3 hist = 0;
    float h = 0;
    if (_Params.w > 0.5 && raw > 0.0 && raw < 1.0)
    {
        float2 ndc = pc * _OutDim.zw * 2.0 - 1.0;
        float3 pw = ReconstructWorld(ndc, zg) + UnpackMotion(motion);
        float4 clip = mul(_PrevScreenVP, float4(pw, 1.0));
        if (clip.w > 1e-4)
        {
            float2 puv = clip.xy / clip.w * 0.5 + 0.5;
            float zExp = clip.w;
            float rtol = zExp * _Params3.x + _Params2.y;
            float2 hp = puv * _OutDim.xy - 0.5;
            int2 hb = (int2)floor(hp);
            float2 f = hp - (float2)hb;
            float4 cs = 0;
            float wsum = 0, bw = 0;
            int valid = 0;
            float3 hmn = 1e5, hmx = -1e5;
            [unroll] for (int k = 0; k < 4; k++)
            {
                int2 o = int2(k & 1, k >> 1);
                int2 q = hb + o;
                float w = (o.x ? f.x : 1.0 - f.x) * (o.y ? f.y : 1.0 - f.y);
                bw += w;
                if (any(q < 0) || any(q >= (int2)_OutDim.xy)) continue;
                float4 hc = _HistIn[q];
                if (hc.a <= 0.0 || abs(_HistDepthIn[q] - zExp) > rtol) continue;
                cs += hc * w;
                wsum += w;
                valid++;
                hmn = min(hmn, hc.rgb); hmx = max(hmx, hc.rgb);
            }
            if (wsum > 1e-3)
            {
                hist = cs.rgb / wsum;
                h = cs.a / wsum * saturate(wsum / max(bw, 1e-4) * 2.0); // partly valid footprint: less trusted
                if (valid == 4 && _Params3.y > 0.5) hist = clamp(HistoryCatmullRom(puv), hmn, hmx);
            }
        }
    }

    float4 result;
    if (n == 0)
    {
        // No trace sample on this surface this frame: keep a valid history (thin geometry), else leave the game's pixel.
        // Only an established history is held, and it decays, so a sliver reached only through the bilinear footprint's
        // tiny weights (where the game shows something at a similar depth that we don't trace) can't creep outwards.
        result = h >= _Params4.x ? float4(hist, h * _Params4.y) : float4(0, 0, 0, 0);
    }
    else
    {
        float3 spatial = sumS / wS; // edge-aware fallback: depth-matched Gaussian of the nearby samples
        if (h > 0.0 && n >= (int)_Params2.w)
        {
            float3 pad = (mx - mn) * _Params2.z + 2.0 / 255.0;
            hist = clamp(hist, mn - pad, mx + pad);
        }
        float ws = _Params3.z;
        float wsum = h + wE + ws;
        float3 c = (hist * h + sumE + spatial * ws) / wsum;
        result = float4(saturate(c), min(wsum, _Params.y));
    }
    if (_Params3.w > 0.5)
    {
        // Debug (UpsamplerSettings.debugView): r matching samples / 9, g history weight / max, b history kept without a sample;
        // written with a = 1 so the composite shows it everywhere, which also breaks the history (debug only).
        float3 dbg = float3(n / 9.0, h / _Params.y, n == 0 && h > 0.0 ? 1.0 : 0.0);
        if (_Params3.w > 1.5) dbg = float3(saturate(zg / 100.0), saturate(raw * 10.0), 0); // game eye depth / 100 m, raw depth x10
        _HistOut[p] = float4(dbg, 1.0); // breaks the history: debug only
        _HistDepthOut[p] = zg;
        return;
    }
    _HistOut[p] = result;
    _HistDepthOut[p] = zg;
}
