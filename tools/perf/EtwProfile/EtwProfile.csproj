<Project Sdk="Microsoft.NET.Sdk">
  <!-- Turns a Windows Performance Recorder CPU trace into per-thread profiles of one process (docs/performance.md, "ETW").
       Build: dotnet build tools\perf\EtwProfile -c Release   (the SDK under %USERPROFILE%\.dotnet, as scripts\build.ps1) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.*" />
  </ItemGroup>
</Project>
