<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>UltraRT</AssemblyName>
    <RootNamespace>UltraRT</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Game location: override with the ULTRAKILL_DIR env var or /p:GameDir=... -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == '' and '$(ULTRAKILL_DIR)' != ''">$(ULTRAKILL_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\ULTRAKILL</GameDir>
    <ManagedDir>$(GameDir)\ULTRAKILL_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <BundlePath>$(MSBuildThisFileDirectory)..\..\unity\UltraRT.Shaders\Build\ultrart.shaders</BundlePath>
  </PropertyGroup>

  <!-- In-game settings menu (SettingsMenu.cs): compiled in when PluginConfigurator.dll is found (the game's plugins folder,
       lib\ (git-ignored; scripts\fetch-pluginconfigurator.ps1 fills it) or /p:PluginConfiguratorDll=...). UltraRT does not
       need it at run time: the menu is only created when the plugin is loaded (docs/settings.md). -->
  <PropertyGroup>
    <PluginConfiguratorDll Condition="'$(PluginConfiguratorDll)' == '' and Exists('$(BepInExDir)\plugins\PluginConfigurator\PluginConfigurator.dll')">$(BepInExDir)\plugins\PluginConfigurator\PluginConfigurator.dll</PluginConfiguratorDll>
    <PluginConfiguratorDll Condition="'$(PluginConfiguratorDll)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\lib\PluginConfigurator.dll')">$(MSBuildThisFileDirectory)..\..\lib\PluginConfigurator.dll</PluginConfiguratorDll>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExDir)\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(ManagedDir)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ManagedDir)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(ManagedDir)\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(ManagedDir)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.ScreenCaptureModule" HintPath="$(ManagedDir)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ManagedDir)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(ManagedDir)\UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(ManagedDir)\UnityEngine.AnimationModule.dll" Private="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(PluginConfiguratorDll)' != ''">
    <Reference Include="PluginConfigurator" HintPath="$(PluginConfiguratorDll)" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ManagedDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="Unity.Addressables" HintPath="$(ManagedDir)\Unity.Addressables.dll" Private="false" />
    <Reference Include="Unity.ResourceManager" HintPath="$(ManagedDir)\Unity.ResourceManager.dll" Private="false" />
  </ItemGroup>
  <PropertyGroup Condition="'$(PluginConfiguratorDll)' != ''">
    <DefineConstants>$(DefineConstants);ULTRART_PLUGINCONFIGURATOR</DefineConstants>
  </PropertyGroup>
  <Target Name="WarnNoPluginConfigurator" BeforeTargets="CoreCompile" Condition="'$(PluginConfiguratorDll)' == ''">
    <Warning Text="PluginConfigurator.dll not found: building without the settings menu (scripts\fetch-pluginconfigurator.ps1 downloads it into lib\)." />
  </Target>

  <!-- Build without touching the game install: /p:Deploy=false (references still resolve from BepInExDir). -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(BepInExDir)') and '$(Deploy)' != 'false'">
    <MakeDir Directories="$(BepInExDir)\plugins\UltraRT" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\UltraRT" />
    <Copy SourceFiles="$(BundlePath)" DestinationFolder="$(BepInExDir)\plugins\UltraRT" Condition="Exists('$(BundlePath)')" />
    <!-- Default reflection material overrides; personal ones go in BepInEx\config\ultrart-materials.json (loaded after). -->
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ultrart-materials.json" DestinationFolder="$(BepInExDir)\plugins\UltraRT" />
    <Warning Text="Shader bundle not built yet: $(BundlePath)" Condition="!Exists('$(BundlePath)')" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -> $(BepInExDir)\plugins\UltraRT" />
  </Target>

</Project>
