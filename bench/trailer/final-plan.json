    "final": { "Mode": "live", "Modes": "pathtrace+ptx.scaleRR=1", "OutputScale": 1, "Fps": 60, "Preroll": 90, "Width": 2560, "Height": 1440, "Crf": 13, "ClipCrf": 8,
               "Exports": [ { "Suffix": "-1080p", "Height": 1080, "Crf": 15 } ] }
  },
